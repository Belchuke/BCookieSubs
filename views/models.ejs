<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Models — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1>Models</h1>
      <% if (user.isAdmin || user.canManageModels) { %>
        <button class="btn btn-primary" onclick="openAddModal()">+ Add Model</button>
      <% } %>
    </div>

    <% if (ollamaRunning === false) { %>
      <div class="alert alert-error" style="margin-bottom:1.5rem">Ollama is not running. Start Ollama to add local models.</div>
    <% } else if (ollamaError) { %>
      <div class="alert alert-warning" style="margin-bottom:1.5rem"><%= ollamaError %></div>
    <% } %>

    
    <div class="card">
      <div class="card-header"><h2>Configured Models</h2></div>
      <% if (models.length === 0) { %>
        <p class="empty-state">No models configured yet.</p>
      <% } else { %>
        
        <div class="table-wrap models-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Model ID</th>
                <th>Provider</th>
                <th>Roles</th>
                <th>Status</th>
                <% if (user.isAdmin || user.canManageModels) { %><th>Actions</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% models.forEach(function(m) { %>
                <% var roleNames = m.roles.map(function(r){ return r.role }) %>
                <% var provider = m.provider || 'ollama' %>
                <tr>
                  <td><strong><%= m.name %></strong></td>
                  <td><code><%= m.modelName %></code>
                    <% if (m.parameterSize) { %><span class="text-dim"> (<%= m.parameterSize %>)</span><% } %>
                  </td>
                  <td>
                    <% if (provider === 'chatgpt') { %>
                      <span class="badge badge-success">ChatGPT</span>
                    <% } else if (provider === 'claude') { %>
                      <span class="badge badge-warning">Claude</span>
                    <% } else if (provider === 'ollama cloud') { %>
                      <span class="badge badge-info">Ollama Cloud</span>
                    <% } else if (provider === 'custom') { %>
                      <span class="badge badge-neutral">Custom</span>
                    <% } else { %>
                      <span class="text-dim">Ollama</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (roleNames.length === 0) { %><span class="text-dim">—</span><% } %>
                    <% if (roleNames.includes('translation')) { %><span class="badge badge-info" style="margin-right:.25rem">Translation</span><% } %>
                    <% if (roleNames.includes('judge')) { %><span class="badge badge-warning" style="margin-right:.25rem">Judge</span><% } %>
                    <% if (roleNames.includes('fallbackJudge')) { %><span class="badge badge-warning" style="margin-right:.25rem;opacity:.7">Fallback Judge</span><% } %>
                    <% if (roleNames.includes('nameFormatter')) { %><span class="badge badge-neutral">Name Formatter</span><% } %>
                  </td>
                  <td>
                    <span class="badge <%= m.active ? 'badge-success' : 'badge-neutral' %>">
                      <%= m.active ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <% if (user.isAdmin || user.canManageModels) { %>
                  <td class="actions">
                    <button class="btn btn-sm btn-secondary"
                            id="edit-btn-<%= m.id %>"
                            data-model="<%- JSON.stringify(m).replace(/"/g, '&quot;') %>">
                      Edit
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            id="role-btn-<%= m.id %>"
                            data-model="<%- JSON.stringify(m).replace(/"/g, '&quot;') %>">
                      Roles
                    </button>
                    <form method="POST" action="/models/delete/<%= m.id %>" style="display:inline"
                          onsubmit="return confirm('Remove model <%= m.name.replace(/'/g, '\\\'') %>?')">
                      <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                    </form>
                  </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        
        <div class="model-cards">
          <% models.forEach(function(m) { %>
            <% var roleNames = m.roles.map(function(r){ return r.role }) %>
            <% var provider = m.provider || 'ollama' %>
            <div class="model-card">
              <div class="model-card-header">
                <div>
                  <strong><%= m.name %></strong>
                  <span class="badge <%= m.active ? 'badge-success' : 'badge-neutral' %>" style="margin-left:.4rem">
                    <%= m.active ? 'Active' : 'Inactive' %>
                  </span>
                </div>
                <span class="text-dim" style="font-size:.8rem"><%= provider %></span>
              </div>
              <div class="model-card-name text-dim"><code><%= m.modelName %></code><% if (m.parameterSize) { %> · <%= m.parameterSize %><% } %></div>
              <div class="model-card-roles" style="margin:1rem 0;display:flex;flex-wrap:wrap;gap:.25rem">
                <% if (roleNames.length === 0) { %><span class="text-dim" style="font-size:.82rem">No roles</span><% } %>
                <% if (roleNames.includes('translation')) { %><span class="badge badge-info">Translation</span><% } %>
                <% if (roleNames.includes('judge')) { %><span class="badge badge-warning">Judge</span><% } %>
                <% if (roleNames.includes('fallbackJudge')) { %><span class="badge badge-warning" style="opacity:.7">Fallback Judge</span><% } %>
                <% if (roleNames.includes('nameFormatter')) { %><span class="badge badge-neutral">Name Formatter</span><% } %>
              </div>
              <% if (user.isAdmin || user.canManageModels) { %>
              <div class="actions">
                <button class="btn btn-sm btn-secondary"
                        id="edit-btn-m-<%= m.id %>"
                        data-model="<%- JSON.stringify(m).replace(/"/g, '&quot;') %>">
                  Edit
                </button>
                <button class="btn btn-sm btn-secondary"
                        id="role-btn-m-<%= m.id %>"
                        data-model="<%- JSON.stringify(m).replace(/"/g, '&quot;') %>">
                  Roles
                </button>
                <form method="POST" action="/models/delete/<%= m.id %>" style="display:inline"
                      onsubmit="return confirm('Remove model <%= m.name.replace(/'/g, '\\\'') %>?')">
                  <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                </form>
              </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (ollamaModels.length > 0) { %>
    <div class="card" style="margin-top:1.5rem">
      <div class="card-header">
        <h2>Available in Ollama</h2>
        <small class="text-dim"><%= ollamaModels.length %> model(s) found</small>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Model</th><th>Size</th><th>Parameters</th><th>Updated At</th><% if (user.isAdmin || user.canManageModels) { %><th style="text-align: center;">Actions</th><% } %></tr>
          </thead>
          <tbody>
            <% ollamaModels.forEach(function(m) { %>
              <% var alreadyAdded = models.some(function(d){ return d.modelName === m.model }) %>
              <tr>
                <td><code><%= m.model %></code></td>
                <td class="text-dim"><%= m.size ? (m.size / 1e9).toFixed(1) + ' GB' : '—' %></td>
                <td class="text-dim"><%= m.parameterSize || '—' %></td>
                <td class="text-dim"><%= m.modifiedAt %></td>
                <% if (user.isAdmin || user.canManageModels) { %>
                <td style="text-align: center; padding-right: 1rem;">
                  <% if (alreadyAdded) { %>
                    <span class="badge badge-success">Added</span>
                  <% } else { %>
                    <div style="display:flex;gap:.35rem;justify-content:center;flex-wrap:wrap">
                      <button class="btn btn-sm btn-primary"
                              data-ollama-model="<%= m.model %>">
                        + Add
                      </button>
                      <form method="POST" action="/models/remove-ollama" style="display:inline"
                            class="ollama-remove-form">
                        <input type="hidden" name="modelName" value="<%= m.model %>">
                        <button type="submit" class="btn btn-sm btn-danger"
                                data-model-name="<%= m.model %>">Remove</button>
                      </form>
                    </div>
                  <% } %>
                </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <% if (recommendedModels && recommendedModels.length > 0) { %>
    <div class="card" style="margin-top:1.5rem">
      <div class="card-header">
        <h2>Recommended Models</h2>
        <small class="text-dim"><%= recommendedModels.length %> model(s)</small>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Provider</th>
              <th>Roles</th>
              <th>Score</th>
              <% if (user.isAdmin || user.canManageModels) { %><th style="text-align:center">Actions</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% recommendedModels.forEach(function(r) { %>
              <tr>
                <td>
                  <code><%= r.name %></code>
                  <% if (r.requireOllamaSubscription) { %>
                    <span class="badge badge-warning" style="margin-left:.35rem">Subscription</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.provider === 'ollama cloud') { %>
                    <span class="badge badge-info">Ollama Cloud</span>
                  <% } else { %>
                    <span class="text-dim">Ollama</span>
                  <% } %>
                </td>
                <td class="text-dim" style="font-size:.82rem"><%= r.roles || '—' %></td>
                <td><span class="badge badge-neutral"><%= r.score %></span></td>
                <% if (user.isAdmin || user.canManageModels) { %>
                <td style="text-align:center">
                  <% if (r.provider === 'ollama cloud' || r.provider === 'chatgpt' || r.provider === 'claude') { %>
                    <form method="POST" action="/models/add-recommended/<%= r.id %>" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-primary">+ Add</button>
                    </form>
                  <% } else { %>
                    <button class="btn btn-sm btn-primary"
                            data-ollama-model="<%= r.name %>"
                            data-recommended-id="<%= r.id %>">
                      + Install
                    </button>
                  <% } %>
                </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

  </main>
</div>

<% if (user.isAdmin || user.canManageModels) { %>

<div class="modal-overlay" id="add-manual-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2 id="add-modal-title">Add Model</h2>
      <button class="btn btn-icon" onclick="closeModal('add-manual-modal')">✕</button>
    </div>
    <form method="POST" id="add-model-form" action="/models/add">
      <input type="hidden" id="add-from-ollama" name="_fromOllama" value="0">

      <div class="field">
        <label for="add-provider">Provider</label>
        <select id="add-provider" name="provider" onchange="onAddProviderChange()">
          <option value="ollama">Ollama (local)</option>
          <option value="ollama cloud">Ollama Cloud</option>
          <option value="chatgpt">ChatGPT (OpenAI)</option>
          <option value="claude">Claude (Anthropic)</option>
          <option value="custom">Custom</option>
        </select>
      </div>

      <div class="field">
        <label for="add-modelName" id="add-modelName-label">Model Name</label>
        <input type="text" id="add-modelName" name="modelName" placeholder="e.g. llama3.1:8b" required>
        <small id="add-modelName-hint" class="text-dim"></small>
      </div>

      <div class="field" id="add-baseUrl-field" style="display:none">
        <label for="add-baseUrl">Base URL</label>
        <input type="text" id="add-baseUrl" name="baseUrl" placeholder="https://your-host:11434">
      </div>

      <div class="field" id="add-apikey-hint-field" style="display:none">
        <div class="alert alert-warning" style="margin:0;font-size:.82em" id="add-apikey-hint"></div>
      </div>

      <div class="field">
        <label for="add-name">Display Name <span class="hint">(leave blank to use model name)</span></label>
        <input type="text" id="add-name" name="name" placeholder="My Model">
      </div>

      <div class="field">
        <label>Roles</label>
        <div class="checkbox-group" style="max-height:none">
          <label class="checkbox-label"><input type="checkbox" class="add-role-check" name="roles" value="translation" checked> Translation</label>
          <label class="checkbox-label"><input type="checkbox" class="add-role-check" name="roles" value="judge"> Judge</label>
          <label class="checkbox-label"><input type="checkbox" class="add-role-check" name="roles" value="fallbackJudge"> Fallback Judge</label>
          <label class="checkbox-label"><input type="checkbox" class="add-role-check" name="roles" value="nameFormatter"> Name Formatter</label>
        </div>
      </div>

      <div class="field field-checkbox" id="add-closeAfterUse-field">
        <input type="hidden" id="add-closeAfterUse-hidden" name="closeAfterUse" value="0" disabled>
        <input type="checkbox" id="add-closeAfterUse" name="closeAfterUse" value="1" checked onchange="document.getElementById('add-closeAfterUse-hidden').disabled = this.checked">
        <label for="add-closeAfterUse">Unload after use <span class="hint">(Ollama only)</span></label>
      </div>

      <div class="field field-checkbox">
        <input type="checkbox" id="add-active" name="active" value="1" checked>
        <label for="add-active">Active</label>
      </div>

      
      <div id="pull-progress-wrap" style="display:none;padding:.75rem 0">
        <div style="font-size:.85rem;margin-bottom:.4rem">
          <strong id="pull-status-text">Installing…</strong>
        </div>
        <div style="background:var(--surface-2);border-radius:var(--radius-sm);height:10px;overflow:hidden;border:1px solid var(--border)">
          <div id="pull-progress-bar" style="height:100%;width:0%;background:var(--accent);transition:width .3s ease"></div>
        </div>
        <small id="pull-progress-label" class="text-dim" style="margin-top:.25rem;display:block"></small>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="add-cancel-btn" onclick="closeModal('add-manual-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary" id="add-submit-btn">Add Model</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="edit-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Model</h2>
      <button class="btn btn-icon" onclick="closeModal('edit-modal')">✕</button>
    </div>
    <form method="POST" id="edit-form" action="">

      <div class="field">
        <label for="edit-provider">Provider</label>
        <select id="edit-provider" name="provider" onchange="onEditProviderChange()">
          <option value="ollama">Ollama (local)</option>
          <option value="ollama cloud">Ollama Cloud</option>
          <option value="chatgpt">ChatGPT (OpenAI)</option>
          <option value="claude">Claude (Anthropic)</option>
          <option value="custom">Custom</option>
        </select>
      </div>

      <div class="field" id="edit-baseUrl-field" style="display:none">
        <label for="edit-baseUrl">Base URL</label>
        <input type="text" id="edit-baseUrl" name="baseUrl" placeholder="https://your-host:11434">
      </div>

      <div class="field" id="edit-apikey-hint-field" style="display:none">
        <div class="alert alert-warning" style="margin:0;font-size:.82em" id="edit-apikey-hint"></div>
      </div>

      <div class="field">
        <label for="edit-name">Display Name</label>
        <input type="text" id="edit-name" name="name" required>
      </div>

      <div class="field field-checkbox" id="edit-closeAfterUse-field">
        <input type="checkbox" id="edit-closeAfterUse" name="closeAfterUse" value="1">
        <label for="edit-closeAfterUse">Unload after use <span class="hint">(Ollama only)</span></label>
      </div>

      <div class="field field-checkbox">
        <input type="checkbox" id="edit-active" name="active" value="1">
        <label for="edit-active">Active</label>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="role-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2>Manage Roles — <span id="role-modal-name"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('role-modal')">✕</button>
    </div>
    <div id="role-modal-body" style="padding:.25rem 0 .5rem"></div>
  </div>
</div>
<% } %>

<div id="ollama-models-data" style="display:none" data-models="<%= JSON.stringify(ollamaModels.map(function(m){ return m.model })) %>"></div>

<script src="/app.js"></script>
<% if (user.isAdmin || user.canManageModels) { %>
<script>
  var INSTALLED_OLLAMA_MODELS = JSON.parse(document.getElementById('ollama-models-data').dataset.models || '[]');

  // ── Provider-aware field visibility ─────────────────────────────────────────
  var PROVIDER_HINTS = {
    'ollama':       { modelLabel: 'Ollama Model Name', placeholder: 'e.g. llama3.1:8b',    hint: '',                                              baseUrl: false, apiHint: '',                                              unload: true  },
    'ollama cloud': { modelLabel: 'Ollama Model Name', placeholder: 'e.g. llama3.1:8b',    hint: '',                                              baseUrl: true,  apiHint: '',                                              unload: false, defaultBaseUrl: 'https://ollama.com' },
    'chatgpt':      { modelLabel: 'OpenAI Model ID',   placeholder: 'e.g. gpt-4o',         hint: '',                                              baseUrl: false, apiHint: 'API key is read from OPENAI_API_KEY env var.',   unload: false },
    'claude':       { modelLabel: 'Claude Model ID',   placeholder: 'e.g. claude-opus-4-5',hint: '',                                              baseUrl: false, apiHint: 'API key is read from ANTHROPIC_API_KEY env var.',unload: false },
    'custom':       { modelLabel: 'Model Name',        placeholder: 'model name',           hint: '',                                              baseUrl: true,  apiHint: '',                                              unload: false },
  };

  function applyProviderUI(prefix, provider) {
    var cfg = PROVIDER_HINTS[provider] || PROVIDER_HINTS['ollama'];
    var lbl = document.getElementById(prefix + '-modelName-label');
    var inp = document.getElementById(prefix + '-modelName');
    var hnt = document.getElementById(prefix + '-modelName-hint');
    if (lbl) lbl.textContent = cfg.modelLabel;
    if (inp) inp.placeholder = cfg.placeholder;
    if (hnt) hnt.textContent = cfg.hint;

    var buField = document.getElementById(prefix + '-baseUrl-field');
    if (buField) buField.style.display = cfg.baseUrl ? '' : 'none';

    var akField = document.getElementById(prefix + '-apikey-hint-field');
    var akHint  = document.getElementById(prefix + '-apikey-hint');
    if (akField) akField.style.display = cfg.apiHint ? '' : 'none';
    if (akHint)  akHint.textContent = cfg.apiHint;

    var ulField = document.getElementById(prefix + '-closeAfterUse-field');
    if (ulField) ulField.style.display = cfg.unload ? '' : 'none';
  }

  function onAddProviderChange() {
    var provider = document.getElementById('add-provider').value;
    applyProviderUI('add', provider);
    var cfg = PROVIDER_HINTS[provider] || PROVIDER_HINTS['ollama'];
    var buInput = document.getElementById('add-baseUrl');
    if (buInput && cfg.defaultBaseUrl) buInput.value = cfg.defaultBaseUrl;
  }
  function onEditProviderChange() {
    applyProviderUI('edit', document.getElementById('edit-provider').value);
  }

  // ── Pull progress ─────────────────────────────────────────────────────────
  var pullInProgress = false;

  function isOllamaProvider(provider) {
    return provider === 'ollama' || provider === 'ollama cloud';
  }

  document.getElementById('add-model-form').addEventListener('submit', function(e) {
    if (pullInProgress) { e.preventDefault(); return; }
    var provider = document.getElementById('add-provider').value;
    var modelName = document.getElementById('add-modelName').value.trim();
    if (!isOllamaProvider(provider)) return; // non-ollama providers: submit normally
    if (INSTALLED_OLLAMA_MODELS.indexOf(modelName) !== -1) return; // already installed: submit normally

    e.preventDefault();
    startPull(modelName, this);
  });

  function startPull(modelName, form) {
    pullInProgress = true;
    document.getElementById('pull-progress-wrap').style.display = '';
    document.getElementById('pull-status-text').textContent = 'Installing ' + modelName + '…';
    document.getElementById('pull-progress-bar').style.width = '0%';
    document.getElementById('pull-progress-label').textContent = '';
    document.getElementById('add-submit-btn').disabled = true;
    document.getElementById('add-cancel-btn').disabled = true;

    var es = new EventSource('/models/pull-stream/' + encodeURIComponent(modelName));

    es.onmessage = function(event) {
      var data = JSON.parse(event.data);
      if (data.error) {
        es.close();
        pullInProgress = false;
        document.getElementById('pull-status-text').textContent = 'Error: ' + data.error;
        document.getElementById('pull-progress-bar').style.background = 'var(--error)';
        document.getElementById('add-submit-btn').disabled = false;
        document.getElementById('add-cancel-btn').disabled = false;
        return;
      }
      if (data.done) {
        es.close();
        pullInProgress = false;
        document.getElementById('pull-status-text').textContent = 'Installed! Adding model…';
        document.getElementById('pull-progress-bar').style.width = '100%';
        document.getElementById('add-submit-btn').disabled = false;
        document.getElementById('add-cancel-btn').disabled = false;
        form.submit();
        return;
      }
      var status = data.status || '';
      document.getElementById('pull-status-text').textContent = status;
      if (data.total && data.completed) {
        var pct = Math.round((data.completed / data.total) * 100);
        document.getElementById('pull-progress-bar').style.width = pct + '%';
        document.getElementById('pull-progress-label').textContent =
          Math.round(data.completed / 1e6) + ' MB / ' + Math.round(data.total / 1e6) + ' MB';
      }
    };

    es.onerror = function() {
      es.close();
      pullInProgress = false;
      document.getElementById('pull-status-text').textContent = 'Connection lost during install.';
      document.getElementById('pull-progress-bar').style.background = 'var(--error)';
      document.getElementById('add-submit-btn').disabled = false;
      document.getElementById('add-cancel-btn').disabled = false;
    };
  }

  function openAddModal() {
    document.getElementById('add-modal-title').textContent = 'Add Model';
    document.getElementById('add-model-form').action = '/models/add';
    document.getElementById('add-from-ollama').value = '0';
    document.getElementById('add-modelName').value = '';
    document.getElementById('add-name').value = '';
    document.getElementById('add-baseUrl').value = '';
    document.getElementById('add-closeAfterUse').checked = true;
    document.getElementById('add-closeAfterUse-hidden').disabled = true;
    document.getElementById('add-active').checked = true;
    document.getElementById('add-provider').value = 'ollama';
    document.querySelectorAll('.add-role-check').forEach(function(cb) {
      cb.checked = cb.value === 'translation';
    });
    applyProviderUI('add', 'ollama');
    openModal('add-manual-modal');
  }

  // ── Edit buttons ─────────────────────────────────────────────────────────────
  document.querySelectorAll('[id^="edit-btn-"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var m = JSON.parse(btn.dataset.model);
      document.getElementById('edit-form').action = '/models/update/' + m.id;
      document.getElementById('edit-name').value = m.name;
      document.getElementById('edit-closeAfterUse').checked = !!m.closeAfterUse;
      document.getElementById('edit-active').checked = !!m.active;
      document.getElementById('edit-provider').value = m.provider || 'ollama';
      document.getElementById('edit-baseUrl').value = m.baseUrl || '';
      applyProviderUI('edit', m.provider || 'ollama');
      openModal('edit-modal');
    });
  });

  // ── Role buttons ─────────────────────────────────────────────────────────────
  document.querySelectorAll('[id^="role-btn-"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var m = JSON.parse(btn.dataset.model);
      document.getElementById('role-modal-name').textContent = m.name;
      var allRoles = [
        { key: 'translation', label: 'Translation', cls: 'badge-info' },
        { key: 'judge', label: 'Judge', cls: 'badge-warning' },
        { key: 'fallbackJudge', label: 'Fallback Judge', cls: 'badge-warning' },
        { key: 'nameFormatter', label: 'Name Formatter', cls: 'badge-neutral' }
      ];
      var currentRoles = (m.roles || []).map(function(r) { return r.role; });
      var html = '<div style="display:flex;flex-direction:column;gap:.6rem;padding:.25rem 0">';
      allRoles.forEach(function(role) {
        var hasRole = currentRoles.indexOf(role.key) !== -1;
        var action = hasRole ? 'remove' : 'add';
        html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border)">';
        html += '<span class="badge ' + role.cls + '">' + role.label + '</span>';
        html += '<form method="POST" action="/models/role/' + m.id + '">';
        html += '<input type="hidden" name="role" value="' + role.key + '">';
        html += '<input type="hidden" name="action" value="' + action + '">';
        html += '<button type="submit" class="btn btn-sm ' + (hasRole ? 'btn-danger' : 'btn-primary') + '">';
        html += hasRole ? 'Remove' : 'Add';
        html += '</button></form></div>';
      });
      html += '</div>';
      document.getElementById('role-modal-body').innerHTML = html;
      openModal('role-modal');
    });
  });

  // ── Quick-add from Ollama list (also used by recommended Install buttons) ────
  document.querySelectorAll('[data-ollama-model]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var modelName = btn.dataset.ollamaModel;
      var recId = btn.dataset.recommendedId || '';
      var isCloud = modelName.indexOf('-cloud') !== -1 || modelName.indexOf(':cloud') !== -1;
      var provider = isCloud ? 'ollama cloud' : 'ollama';
      document.getElementById('add-modal-title').textContent = 'Add Model from Ollama';
      document.getElementById('add-model-form').action = '/models/sync';
      document.getElementById('add-from-ollama').value = '1';
      document.getElementById('add-modelName').value = modelName;
      document.getElementById('add-name').value = '';
      document.getElementById('add-closeAfterUse').checked = true;
      document.getElementById('add-closeAfterUse-hidden').disabled = true;
      document.getElementById('add-active').checked = true;
      document.getElementById('add-provider').value = provider;
      // Inject recommendedModelId if coming from recommended section
      var recInput = document.getElementById('add-recommended-id');
      if (!recInput) {
        recInput = document.createElement('input');
        recInput.type = 'hidden';
        recInput.name = 'recommendedModelId';
        recInput.id = 'add-recommended-id';
        document.getElementById('add-model-form').appendChild(recInput);
      }
      recInput.value = recId;
      document.querySelectorAll('.add-role-check').forEach(function(cb) {
        cb.checked = cb.value === 'translation';
      });
      applyProviderUI('add', provider);
      var cfg = PROVIDER_HINTS[provider] || PROVIDER_HINTS['ollama'];
      var buInput = document.getElementById('add-baseUrl');
      if (buInput) buInput.value = cfg.defaultBaseUrl || '';
      openModal('add-manual-modal');
    });
  });

  // ── Ollama remove confirm ─────────────────────────────────────────────────
  document.querySelectorAll('.ollama-remove-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      var btn = form.querySelector('[data-model-name]');
      var name = btn ? btn.getAttribute('data-model-name') : 'this model';
      if (!confirm('Remove ' + name + ' from Ollama? This cannot be undone.')) {
        e.preventDefault();
      }
    });
  });
</script>
<% } %>
</body>
</html>

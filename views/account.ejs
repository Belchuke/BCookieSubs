<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('account.title') %> — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header"><h1><%= __('account.title') %></h1></div>

    <div class="account-grid">

      <div class="card card-profile">
        <div class="card-header"><h2><%= __('account.profile') %></h2></div>
        <form method="POST" action="/account/username" id="username-form">
          <div  style="display:flex;gap:.5rem;align-items:flex-end">
            <div class="field" style="flex:1;margin-bottom: 0px;">
              <label for="username"><%= __('account.username') %></label>
              <input type="text" id="username" name="username" value="<%= user.username %>" required minlength="1">
            </div>
            <button type="submit" class="btn btn-primary" style="flex-shrink:0"><%= __('common.save') %></button>
          </div>
        </form>
      </div>

      <div class="card card-langs" style="display:flex;flex-direction:column">
        <div class="card-header">
          <h2><%= __('account.myTargetLanguages') %></h2>
          <small class="text-dim"><%= __('account.preSelectedOnUpload') %> <i class="fa-solid fa-circle-info setting-info" data-tip="These languages are pre-selected when you upload an SRT file or choose a movie/episode to translate."></i></small>
        </div>

        <% if (userConfigLangs.length === 0) { %>
          <p class="empty-state"><%= __('account.noDefaultsSet') %></p>
        <% } else { %>
          <div style="display:flex;flex-direction:column;gap:.35rem;flex:1">
            <% userConfigLangs.forEach(function(cl, idx) { %>
              <% var lang = languages.find(function(l){ return l.id === cl.languageId }) %>
              <div style="display:flex;align-items:center;gap:.5rem;padding:.4rem 0;border-bottom:1px solid var(--border)">
                <span class="text-dim" style="width:1.5rem;text-align:right;font-size:.8rem"><%= idx + 1 %>.</span>
                <span style="flex:1"><%= lang ? ((lang.flag || '') + ' ' + lang.name) : 'Unknown' %></span>

                <form method="POST" action="/account/translationlangs/move/<%= cl.languageId %>" style="display:inline">
                  <input type="hidden" name="direction" value="up">
                  <button type="submit" class="btn btn-icon btn-sm" <%= idx === 0 ? 'disabled' : '' %> title="Move up">↑</button>
                </form>

                <form method="POST" action="/account/translationlangs/move/<%= cl.languageId %>" style="display:inline">
                  <input type="hidden" name="direction" value="down">
                  <button type="submit" class="btn btn-icon btn-sm" <%= idx === userConfigLangs.length - 1 ? 'disabled' : '' %> title="Move down">↓</button>
                </form>

                <form method="POST" action="/account/translationlangs/remove/<%= cl.languageId %>" style="display:inline">
                  <button type="submit" class="btn btn-sm btn-danger">✕</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>

        <% if (languages.length > 0) { %>
          <form
            method="POST"
            action="/account/translationlangs/add"
            style="
              display:flex;
              gap:.5rem;
              align-items:flex-end;
              margin-top:auto;
              padding-top:.75rem;
              <%= userConfigLangs.length === 0 ? 'border-top:1px solid var(--border);' : '' %>
            "
          >
            <div class="field" style="flex:1;margin:0">
              <label><%= __('account.addLanguage') %></label>
              <select name="languageId">
                <% languages.forEach(function(l) { %>
                  <option value="<%= l.id %>"><%= l.flag ? l.flag + ' ' : '' %><%= l.name %></option>
                <% }) %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary"><%= __('common.add') %></button>
          </form>
        <% } %>
      </div>

      <div class="card card-settings">
        <div class="card-header"><h2><%= __('account.settings') %></h2></div>
        <form method="POST" action="/account/showPosters" style="display:flex;flex-direction:column;gap:.6rem">
          <div class="field field-checkbox" style="margin:0">
            <input type="checkbox" id="showPostersToggle" name="showPosters" value="1" <%= user.showPosters !== 0 ? 'checked' : '' %>>
            <label for="showPostersToggle"><%= __('account.showMediaPosters') %> <span class="text-dim" style="font-size:.8rem"><%= __('account.whenAvailable') %></span></label>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self:flex-end"><%= __('common.save') %></button>
        </form>
      </div>

      <div class="card card-language">
        <div class="card-header"><h2><%= __('account.language') %></h2></div>
        <small class="text-dim" style="display:block;margin-bottom:.75rem"><%= __('account.languageDescription') %></small>
        <form method="POST" action="/account/language" style="display:flex;gap:.5rem;align-items:flex-end">
          <div class="field" style="flex:1;margin-bottom:0">
            <select name="language">
              <option value="system" <%= !user.language ? 'selected' : '' %>><%= __('account.systemDefault') %></option>
              <% supportedLocales.forEach(function(lc) { %>
                <option value="<%= lc %>" <%= user.language === lc ? 'selected' : '' %>><%= localeFlags[lc] %> <%= localeLabels[lc] %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="flex-shrink:0"><%= __('account.saveLanguage') %></button>
        </form>
      </div>

      <div class="card card-theme">
        <div class="card-header"><h2><%= __('account.theme') %></h2></div>
        <form method="POST" action="/account/theme" style="display:flex;gap:.5rem;align-items:flex-end">
          <div class="field" style="flex:1;margin-bottom:0">
            <label for="themeId"><%= __('account.selectedTheme') %></label>
            <select id="themeId" name="themeId">
              <% themes.forEach(function(t) { %>
                <option value="<%= t.id %>" <%= t.id === theme.id ? 'selected' : '' %>><%= t.name %><%= !t.isPublic ? ' ✏' : '' %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="flex-shrink:0"><%= __('common.apply') %></button>
        </form>
      </div>

      <div class="card card-password" style="display:flex;flex-direction:column">
        <div class="card-header"><h2><%= __('account.changePassword') %></h2></div>
        <form method="POST" action="/account/password" id="password-form" style="display:flex;flex-direction:column;flex:1">
          <div class="field">
            <label for="currentPassword"><%= __('account.currentPassword') %></label>
            <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
          </div>
          <div class="field">
            <label for="newPassword"><%= __('account.newPassword') %> <span class="hint"><%= __('account.newPasswordMin') %></span></label>
            <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
          </div>
          <div class="field">
            <label for="newPassword2"><%= __('account.confirmNewPassword') %></label>
            <input type="password" id="newPassword2" name="newPassword2" required autocomplete="new-password">
          </div>
          <div id="password-error" class="alert alert-error" style="display:none;margin-bottom:.75rem"></div>
          <button type="submit" class="btn btn-primary" style="margin-top:auto;align-self:flex-end"><%= __('account.updatePassword') %></button>
        </form>
      </div>

      <div class="card" style="margin-top:0">
        <div class="card-header"><h2><%= __('account.myRoles') %></h2></div>
        <% if (!userRoles || userRoles.length === 0) { %>
          <p class="empty-state"><%= __('account.noRolesAssigned') %></p>
        <% } else { %>
          <div style="display:flex;flex-direction:column;gap:.5rem">
            <% userRoles.forEach(function(r) { %>
              <div style="display:flex;align-items:center;gap:.6rem;padding:.4rem 0;border-bottom:1px solid var(--border)">
                <span class="badge badge-neutral"><%= r.name %></span>
                <span class="text-dim" style="font-size:.82rem"><%= __('common.level') %> <%= r.level %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script src="/app.js"></script>
<script>
  (function () {
    var pwForm = document.getElementById('password-form')
    if (!pwForm) return
    pwForm.addEventListener('submit', function (e) {
      var pw = document.getElementById('newPassword').value
      var pw2 = document.getElementById('newPassword2').value
      var err = document.getElementById('password-error')
      if (pw.length < 8) {
        err.textContent = 'Password must be at least 8 characters.'
        err.style.display = ''
        e.preventDefault()
        return
      }
      if (pw !== pw2) {
        err.textContent = 'Passwords do not match.'
        err.style.display = ''
        e.preventDefault()
        return
      }
      err.style.display = 'none'
    })
  })()
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('users.title') %> — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('users.title') %></h1>
      <% if (can('canAddUser')) { %>
        <button class="btn btn-primary" onclick="openModal('add-modal')"><%= __('users.createUser') %></button>
      <% } %>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <% if (users.length === 0) { %>
        <p class="empty-state"><%= __('users.noUsersFound') %></p>
      <% } else { %>

      <div class="table-wrap users-table-wrap">
        <table>
          <thead>
            <tr>
              <th><%= __('users.username') %></th>
              <th><%= __('users.roles') %></th>
              <th><%= __('users.created') %></th>
              <th class="usr-th-actions"><%= __('users.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <%
                var _highestRole = u.roles && u.roles.length > 0
                  ? u.roles.reduce(function(best, r) { return r.level > best.level ? r : best }, u.roles[0])
                  : null
              %>
              <tr>
                <td>
                  <strong><%= u.username %></strong>
                  <% if (u.id === user.id) { %>
                    <span class="badge badge-info usr-ml-half"><%= __('common.you') %></span>
                  <% } %>
                </td>
                <td>
                  <% if (!u.roles || u.roles.length === 0) { %>
                    <span class="text-dim">—</span>
                  <% } else { %>
                    <% u.roles.slice().sort(function(a,b){ return b.level - a.level }).forEach(function(r) { %>
                      <span class="badge badge-neutral usr-mr-tiny"><%= r.name %></span>
                    <% }) %>
                  <% } %>
                </td>
                <td class="text-dim"><%= u.createdAt.split(' ')[0] %></td>
                <td class="actions usr-actions-end">
                  <% if (can('canManageRoles') && u.id !== user.id) { %>
                    <button class="btn btn-sm btn-secondary user-edit-btn"
                            data-user-id="<%= u.id %>"
                            data-username="<%= u.username.replace(/'/g, '&#39;') %>"
                            data-role-ids="<%- JSON.stringify((u.roles || []).map(function(r){ return r.id })) %>">
                      <%= __('users.editRoles') %>
                    </button>
                  <% } %>
                  <% if (can('canChangeOtherUsersPassword') && u.id !== user.id) { %>
                    <button class="btn btn-sm btn-secondary user-pw-btn"
                            data-id="<%= u.id %>"
                            data-username="<%= u.username.replace(/'/g, '&#39;') %>">
                      <%= __('users.changePassword') %>
                    </button>
                  <% } %>
                  <% if (can('canAddUser') && u.id !== user.id) { %>
                    <form method="POST" action="/users/delete/<%= u.id %>" class="usr-inline"
                          onsubmit="return confirm('Delete user <%= u.username.replace(/'/g, '\\\'') %>?')">
                      <button type="submit" class="btn btn-sm btn-danger"><%= __('common.delete') %></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="user-cards">
        <% users.forEach(function(u) { %>
          <%
            var _highestRole = u.roles && u.roles.length > 0
              ? u.roles.reduce(function(best, r) { return r.level > best.level ? r : best }, u.roles[0])
              : null
          %>
          <div class="user-card">
            <div class="user-card-header">
              <div>
                <strong><%= u.username %></strong>
                <% if (u.id === user.id) { %>
                  <span class="badge badge-info usr-ml-sm"><%= __('common.you') %></span>
                <% } %>
              </div>
              <% if (_highestRole) { %>
                <span class="badge badge-neutral"><%= _highestRole.name %></span>
              <% } else { %>
                <span class="badge badge-neutral"><%= __('common.noRole') %></span>
              <% } %>
            </div>
            <div class="text-dim usr-card-created">Created <%= u.createdAt.split(' ')[0] %></div>
            <div class="actions">
              <% if (can('canManageRoles') && u.id !== user.id) { %>
                <button class="btn btn-sm btn-secondary user-edit-btn"
                        data-user-id="<%= u.id %>"
                        data-username="<%= u.username.replace(/'/g, '&#39;') %>"
                        data-role-ids="<%- JSON.stringify((u.roles || []).map(function(r){ return r.id })) %>">
                  <%= __('users.editRoles') %>
                </button>
              <% } %>
              <% if (can('canChangeOtherUsersPassword') && u.id !== user.id) { %>
                <button class="btn btn-sm btn-secondary user-pw-btn"
                        data-id="<%= u.id %>"
                        data-username="<%= u.username.replace(/'/g, '&#39;') %>">
                  <%= __('users.changePassword') %>
                </button>
              <% } %>
              <% if (can('canAddUser') && u.id !== user.id) { %>
                <form method="POST" action="/users/delete/<%= u.id %>" class="usr-inline"
                      onsubmit="return confirm('Delete user <%= u.username.replace(/'/g, '\\\'') %>?')">
                  <button type="submit" class="btn btn-sm btn-danger"><%= __('common.delete') %></button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- Roles section -->
    <div class="page-header usr-section-mt">
      <h2 class="usr-roles-heading"><%= __('users.rolesTitle') %></h2>
      <% if (can('canManageRoles')) { %>
        <button class="btn btn-primary" onclick="openModal('create-role-modal')"><%= __('users.createRole') %></button>
      <% } %>
    </div>

    <div class="card">
      <% if (rolesWithPermissions.length === 0) { %>
        <p class="empty-state"><%= __('users.noRolesDefined') %></p>
      <% } else { %>
        <div class="usr-stack-sm">
          <% rolesWithPermissions.forEach(function(r) { %>
            <%
              var BUILT_IN = ['User','SuperUser','MasterUser','Admin','Owner']
              var isBuiltIn = BUILT_IN.indexOf(r.name) !== -1
            %>
            <div class="role-row usr-role-box" id="role-row-<%= r.id %>">
              <div class="usr-role-head">
                <div class="usr-role-meta">
                  <span class="badge badge-neutral usr-noshrink"><%= r.name %></span>
                  <span class="text-dim usr-role-level"><%= __('common.level') %> <%= r.level %></span>
                  <% if (isBuiltIn) { %>
                    <span class="badge badge-info usr-role-builtin"><%= __('common.builtIn') %></span>
                  <% } %>
                  <% if (r.description) { %>
                    <span class="text-dim usr-role-desc"><%= r.description %></span>
                  <% } %>
                </div>
                <div class="usr-role-actions">
                  <button class="btn btn-sm btn-secondary role-toggle-btn" data-role-id="<%= r.id %>" title="Show/hide permissions">
                    <i class="fa-solid fa-chevron-down"></i>
                  </button>
                  <% if (can('canManageRoles')) { %>
                    <button class="btn btn-sm btn-secondary role-edit-btn"
                            data-role='<%- JSON.stringify({id: r.id, name: r.name, level: r.level, description: r.description || "", permissionKeys: r.permissionKeys}).replace(/'/g,"&#39;") %>'>
                      <%= __('common.edit') %>
                    </button>
                    <% if (!isBuiltIn) { %>
                      <form method="POST" action="/users/roles/delete/<%= r.id %>" class="usr-inline"
                            onsubmit="return confirm('Delete role <%= r.name %>?')">
                        <button type="submit" class="btn btn-sm btn-danger"><%= __('common.delete') %></button>
                      </form>
                    <% } %>
                  <% } %>
                </div>
              </div>

              <!-- Permission list (collapsed by default) -->
              <div class="role-perms-panel usr-perms-panel" id="role-perms-<%= r.id %>">
                <% if (r.permissionKeys.length === 0) { %>
                  <span class="text-dim usr-fs-82"><%= __('users.noPermissionsAssigned') %></span>
                <% } else { %>
                  <%
                    var cats = {}
                    r.permissionKeys.forEach(function(key) {
                      var def = permissions.find(function(p){ return p.key === key })
                      if (!def) return
                      if (!cats[def.category]) cats[def.category] = []
                      cats[def.category].push(def)
                    })
                  %>
                  <div class="usr-perms-cats">
                    <% Object.keys(cats).forEach(function(cat) { %>
                      <div class="usr-perms-cat">
                        <div class="usr-perms-cat-label"><%= cat %></div>
                        <div class="usr-perms-list">
                          <% cats[cat].forEach(function(p) { %>
                            <span class="usr-perm-item" title="<%= p.description %>"><i class="fa-solid fa-check usr-perm-check"></i><%= p.label %></span>
                          <% }) %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Create User modal -->
<% if (can('canAddUser')) { %>
<div class="modal-overlay" id="add-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2><%= __('users.createUserModal') %></h2>
      <button class="btn btn-icon" onclick="closeModal('add-modal')">✕</button>
    </div>
    <form method="POST" action="/users/create" id="create-user-form">
      <div id="create-user-error" class="alert alert-error usr-alert-hidden"></div>
      <div class="field">
        <label for="cu-username"><%= __('users.username') %></label>
        <input type="text" id="cu-username" name="username" required>
      </div>
      <div class="field">
        <label for="cu-password"><%= __('users.password') %> <span class="hint"><%= __('users.passwordHint') %></span></label>
        <input type="password" id="cu-password" name="password" required minlength="8">
      </div>
      <div class="field">
        <label for="cu-password2"><%= __('users.confirmPassword') %></label>
        <input type="password" id="cu-password2" name="password2" required>
      </div>
      <div class="field">
        <label for="cu-roleId"><%= __('users.role') %></label>
        <select id="cu-roleId" name="roleId" required>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.name %> (<%= __('common.level') %> <%= r.level %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="cu-language"><%= __('account.language') %></label>
        <select id="cu-language" name="language">
          <option value="system" selected><%= __('account.systemDefault') %></option>
          <% supportedLocales.forEach(function(lc) { %>
            <option value="<%= lc %>"><%= localeFlags[lc] %> <%= localeLabels[lc] %></option>
          <% }) %>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('add-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('users.createUserModal') %></button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- Edit User Roles modal -->
<% if (can('canManageRoles')) { %>
<div class="modal-overlay" id="edit-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2><%= __('users.editRolesModal') %> <span id="edit-username"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('edit-modal')">✕</button>
    </div>
    <form method="POST" id="edit-form" action="">
      <div class="field">
        <label><%= __('users.roles') %></label>
        <div class="checkbox-group usr-maxh-none">
          <% roles.forEach(function(r) { %>
            <label class="checkbox-label">
              <input type="checkbox" name="roleIds" value="<%= r.id %>" data-role-id="<%= r.id %>">
              <%= r.name %> <span class="text-dim usr-fs-80">(<%= __('common.level') %> <%= r.level %>)</span>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('users.saveRoles') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Create Role modal -->
<div class="modal-overlay" id="create-role-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h2><%= __('users.createRoleModal') %></h2>
      <button class="btn btn-icon" onclick="closeModal('create-role-modal')">✕</button>
    </div>
    <form method="POST" action="/users/roles/create">
      <div class="field-row">
        <div class="field usr-flex-2">
          <label><%= __('users.roleName') %></label>
          <input type="text" name="name" required placeholder="e.g. Translator">
        </div>
        <div class="field usr-flex-1">
          <label><%= __('users.level') %></label>
          <input type="number" name="level" min="1" required placeholder="e.g. 15">
        </div>
      </div>
      <div class="field">
        <label><%= __('users.descriptionOptional') %></label>
        <input type="text" name="description" placeholder="Short description of this role">
      </div>
      <div class="field">
        <label><%= __('users.permissions') %></label>
        <%- include('partials/permission-checkboxes', { permissions: permissions, checkedKeys: [] }) %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('create-role-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('users.createRoleModal') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Role modal -->
<div class="modal-overlay" id="edit-role-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h2><%= __('users.editRoleModal') %> <span id="edit-role-name"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('edit-role-modal')">✕</button>
    </div>
    <form method="POST" id="edit-role-form" action="">
      <div class="field-row">
        <div class="field usr-flex-2">
          <label><%= __('users.roleName') %></label>
          <input type="text" id="er-name" name="name" required>
        </div>
        <div class="field usr-flex-1">
          <label><%= __('users.level') %></label>
          <input type="number" id="er-level" name="level" min="1" required>
        </div>
      </div>
      <div class="field">
        <label><%= __('users.descriptionOptional') %></label>
        <input type="text" id="er-description" name="description">
      </div>
      <div class="field">
        <label><%= __('users.permissions') %></label>
        <div id="edit-role-perms">
          <%- include('partials/permission-checkboxes', { permissions: permissions, checkedKeys: [] }) %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-role-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('users.saveRole') %></button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- Change Password modal -->
<div class="modal-overlay" id="pw-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2><%= __('users.changePasswordModal') %> <span id="pw-username"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('pw-modal')">✕</button>
    </div>
    <form method="POST" id="pw-form" action="">
      <div id="pw-error" class="alert alert-error usr-alert-hidden"></div>
      <div class="field">
        <label for="pw-password"><%= __('users.newPassword') %> <span class="hint"><%= __('users.passwordHint') %></span></label>
        <input type="password" id="pw-password" name="password" required minlength="8">
      </div>
      <div class="field">
        <label for="pw-password2"><%= __('users.confirmPassword') %></label>
        <input type="password" id="pw-password2" name="password2" required>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('pw-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('users.updatePassword') %></button>
      </div>
    </form>
  </div>
</div>

<script src="/app.js"></script>
<script>
  var ALL_PERMISSIONS = <%- JSON.stringify(permissions.map(function(p){ return { key: p.key, label: p.label, description: p.description, category: p.category } })) %>;

  document.querySelectorAll('.user-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var userId = btn.dataset.userId;
      var username = btn.dataset.username;
      var currentRoleIds = JSON.parse(btn.dataset.roleIds || '[]');
      document.getElementById('edit-username').textContent = username;
      document.getElementById('edit-form').action = '/users/update-roles/' + userId;
      document.querySelectorAll('#edit-form [data-role-id]').forEach(function(el) {
        el.checked = currentRoleIds.indexOf(parseInt(el.dataset.roleId)) !== -1;
      });
      openModal('edit-modal');
    });
  });

  document.querySelectorAll('.user-pw-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('pw-username').textContent = btn.dataset.username;
      document.getElementById('pw-form').action = '/users/change-password/' + btn.dataset.id;
      document.getElementById('pw-password').value = '';
      document.getElementById('pw-password2').value = '';
      document.getElementById('pw-error').style.display = 'none';
      openModal('pw-modal');
    });
  });

  document.querySelectorAll('.role-toggle-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var roleId = btn.dataset.roleId;
      var panel = document.getElementById('role-perms-' + roleId);
      var icon = btn.querySelector('i');
      if (panel.style.display === 'none') {
        panel.style.display = '';
        icon.classList.replace('fa-chevron-down', 'fa-chevron-up');
      } else {
        panel.style.display = 'none';
        icon.classList.replace('fa-chevron-up', 'fa-chevron-down');
      }
    });
  });

  document.querySelectorAll('.role-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var role = JSON.parse(btn.dataset.role);
      document.getElementById('edit-role-name').textContent = role.name;
      document.getElementById('edit-role-form').action = '/users/roles/update/' + role.id;
      document.getElementById('er-name').value = role.name;
      document.getElementById('er-level').value = role.level;
      document.getElementById('er-description').value = role.description || '';

      var container = document.getElementById('edit-role-perms');
      container.innerHTML = buildPermissionCheckboxes(role.permissionKeys || []);
      openModal('edit-role-modal');
    });
  });

  function buildPermissionCheckboxes(checkedKeys) {
    var cats = {};
    ALL_PERMISSIONS.forEach(function(p) {
      if (!cats[p.category]) cats[p.category] = [];
      cats[p.category].push(p);
    });
    var html = '<div style="display:flex;flex-direction:column;gap:.75rem">';
    Object.keys(cats).forEach(function(cat) {
      html += '<div>';
      html += '<div style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text-dim);margin-bottom:.35rem">' + esc(cat) + '</div>';
      html += '<div class="checkbox-group" style="max-height:none">';
      cats[cat].forEach(function(p) {
        var checked = checkedKeys.indexOf(p.key) !== -1 ? ' checked' : '';
        html += '<label class="checkbox-label" title="' + esc(p.description) + '">';
        html += '<input type="checkbox" name="permissionKeys" value="' + esc(p.key) + '"' + checked + '>';
        html += ' ' + esc(p.label);
        html += '</label>';
      });
      html += '</div></div>';
    });
    html += '</div>';
    return html;
  }

  function validatePasswords(form, errorId) {
    var pw = form.querySelector('[name="password"]');
    var pw2 = form.querySelector('[name="password2"]');
    var errEl = document.getElementById(errorId);
    if (!pw || !pw2) return true;
    var error = '';
    if (pw.value.length < 8) error = 'Password must be at least 8 characters.';
    else if (pw.value !== pw2.value) error = 'Passwords do not match.';
    if (error) {
      if (errEl) { errEl.textContent = error; errEl.style.display = ''; }
      return false;
    }
    if (errEl) errEl.style.display = 'none';
    return true;
  }

  document.getElementById('pw-form').addEventListener('submit', function(e) {
    if (!validatePasswords(this, 'pw-error')) {
      e.preventDefault();
      return;
    }
    var submitBtn = this.querySelector('button[type="submit"]');
    var cancelBtn = this.querySelector('button[type="button"]');
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Updating…'; }
    if (cancelBtn) cancelBtn.disabled = true;
  });

  var createForm = document.getElementById('create-user-form');
  if (createForm) {
    createForm.addEventListener('submit', function(e) {
      if (!validatePasswords(this, 'create-user-error')) {
        e.preventDefault();
        return;
      }
      var submitBtn = this.querySelector('button[type="submit"]');
      var cancelBtn = this.querySelector('button[type="button"]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Creating…'; }
      if (cancelBtn) cancelBtn.disabled = true;
    });
  }

  var editForm = document.getElementById('edit-form');
  if (editForm) {
    editForm.addEventListener('submit', function(e) {
      var submitBtn = this.querySelector('button[type="submit"]');
      var cancelBtn = this.querySelector('button[type="button"]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving…'; }
      if (cancelBtn) cancelBtn.disabled = true;
    });
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('librarypaths.title') %> — BCookieSubs</title>
  <%- include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast === 'error' && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('librarypaths.title') %></h1>
      <button class="btn btn-primary" onclick="openModal('add-modal')"><%= __('librarypaths.addPath') %></button>
    </div>

    <div class="tabs lpx-tabs">
      <button type="button" id="lp-tab-btn-movie" class="tab-btn active" onclick="lpSwitchTab('movie')"><%= __('librarypaths.movie') %></button>
      <button type="button" id="lp-tab-btn-series" class="tab-btn" onclick="lpSwitchTab('series')"><%= __('librarypaths.series') %></button>
      <button type="button" id="lp-tab-btn-blacklist" class="tab-btn" onclick="lpSwitchTab('blacklist')"><%= __('librarypaths.blacklistedTab') %></button>
    </div>

    <%# ── Movies tab ─────────────────────────────────────────────── %>
    <div id="lp-tab-movie">
      <div class="lpx-filter-row">
        <div class="field lpx-search-field">
          <input type="search" class="lp-search" placeholder="<%= __('libraryrequests.searchPlaceholder') %>">
        </div>
        <div class="field lpx-genre-field">
          <select class="lp-genre-filter">
            <option value=""><%= __('libraryrequests.allGenres') %></option>
          </select>
        </div>
      </div>
      <div class="lp-list-root" data-tab="movie"></div>
    </div>

    <%# ── Series tab ─────────────────────────────────────────────── %>
    <div id="lp-tab-series" style="display:none">
      <div class="lpx-filter-row">
        <div class="field lpx-search-field">
          <input type="search" class="lp-search" placeholder="<%= __('libraryrequests.searchPlaceholder') %>">
        </div>
        <div class="field lpx-genre-field">
          <select class="lp-genre-filter">
            <option value=""><%= __('libraryrequests.allGenres') %></option>
          </select>
        </div>
      </div>
      <div class="lp-list-root" data-tab="series"></div>
    </div>

    <%# ── Blacklist tab (rendered client-side) ───────────────────── %>
    <div id="lp-tab-blacklist" style="display:none">
      <div class="card">
        <div class="lp-blacklist-root"></div>
      </div>
    </div>
  </main>
</div>
<div id="lp-config" data-show-posters="<%= showPosters ? '1' : '0' %>" hidden></div>

<script>
  window.LP_PERMS = <%- JSON.stringify(perms) %>;
  window.LP_I18N = <%- JSON.stringify(i18n) %>;
  window.LP_SHOW_POSTERS = <%= showPosters ? 'true' : 'false' %>;
  window.LP_ROOT_PATH = <%- JSON.stringify(rootLibraryPath) %>;
</script>

<div id="dir-browser-panel" style="display:none;margin-top:.5rem">
  <div class="lpx-dir-box">
    <div class="lpx-dir-header">
      <button type="button" id="dir-up-btn"
        class="btn btn-icon btn-sm lpx-dir-up-btn"
        title="Go up">↑</button>
      <span id="dir-current-path"
        class="text-dim lpx-dir-current"></span>
    </div>
    <div id="dir-list"
      class="lpx-dir-list">
      <div class="text-dim lpx-dir-loading">Loading…</div>
    </div>
    <div class="lpx-dir-footer">
      <button type="button" id="dir-select-btn" class="btn btn-sm btn-primary">
        <%= __('librarypaths.selectThisFolder') %>
      </button>
    </div>
  </div>
</div>

<%# ── Bulk action bar ─────────────────────────────────────────────── %>
<div id="lp-bulk-bar" class="lp-bulk-bar" style="display:none">
  <span id="lp-bulk-count" class="lpx-bulk-count">0 files selected</span>
  <button type="button" class="btn btn-primary btn-sm" id="lp-bulk-change-match-btn">
    <i class="fa-solid fa-link"></i> <%= __('librarypaths.bulkChangeMatch') %>
  </button>
  <button type="button" class="btn btn-secondary btn-sm" id="lp-bulk-clear-btn">
    <%= __('librarypaths.bulkClear') %>
  </button>
</div>

<%# ── Bulk change match modal ─────────────────────────────────────── %>
<div class="modal-overlay" id="bulk-match-modal">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2>Change match — <span id="bulk-modal-count">0</span> files</h2>
      <button class="btn btn-icon" onclick="closeModal('bulk-match-modal')">✕</button>
    </div>
    <p class="text-dim lpx-modal-hint">Search TheMovieDB and select the correct title. All selected files will be re-matched.</p>
    <div class="field">
      <label for="bulk-tmdb-search">Search</label>
      <input type="search" id="bulk-tmdb-search" placeholder="Title…" autocomplete="off">
    </div>
    <div id="bulk-tmdb-results" class="lpx-mt-25"></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('bulk-match-modal')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="add-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal lpx-modal-480">
    <div class="modal-header">
      <h2><%= __('librarypaths.addPathTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('add-modal')">✕</button>
    </div>
    <form method="POST" action="/library-paths/create">
      <div class="field">
        <label for="add-name"><%= __('common.name') %></label>
        <input type="text" id="add-name" name="name" required placeholder="e.g. My Movies">
      </div>
      <div class="field">
        <label for="add-path"><%= __('librarypaths.filesystemPath') %></label>
        <div class="lpx-path-input-row">
          <input type="text" id="add-path" name="path" required class="lpx-flex1">
          <button type="button" class="btn btn-secondary lpx-flex-shrink0"
                  onclick="openDirBrowser('add-path')"><%= __('librarypaths.browse') %></button>
        </div>
        <div id="add-path-browser-anchor"></div>
      </div>
      <div class="field">
        <label for="add-type"><%= __('librarypaths.type') %></label>
        <select id="add-type" name="type" required>
          <option value="movie"><%= __('librarypaths.movie') %></option>
          <option value="series"><%= __('librarypaths.series') %></option>
        </select>
      </div>
      <div class="field">
        <label for="add-sourceLangId"><%= __('librarypaths.sourceLanguage') %></label>
        <select id="add-sourceLangId" name="sourceLangId" required>
          <% var addEnglishFound = false; languages.forEach(function(l) { %>
            <option value="<%= l.id %>" <%= !addEnglishFound && l.iso639 === 'en' ? 'selected' : '' %>><%= l.flag ? l.flag + ' ' : '' %><%= l.name %></option>
            <% if (l.iso639 === 'en') addEnglishFound = true; %>
          <% }) %>
        </select>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" id="add-enabled" name="enabled" value="1" checked>
        <label for="add-enabled"><%= __('librarypaths.enabledActivelyScanned') %></label>
      </div>
      <div class="field field-checkbox" style="display:none">
        <input type="checkbox" id="add-autoTranslate" name="autoTranslate" value="1">
        <label for="add-autoTranslate"><%= __('librarypaths.autoTranslate') %></label>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" id="add-autoExtract" name="autoExtract" value="1">
        <label for="add-autoExtract"><%= __('librarypaths.autoExport') %></label>
      </div>
      <div class="field">
        <label><%= __('librarypaths.scanFrequency') %></label>
        <div class="lpx-scan-radios">
          <label class="lpx-radio"><input type="radio" name="scanMode" value="hourly" checked data-scan-mode="add"><%= __('librarypaths.scanHourly') %></label>
          <label class="lpx-radio"><input type="radio" name="scanMode" value="custom" data-scan-mode="add"><%= __('librarypaths.scanCustom') %></label>
          <label class="lpx-radio"><input type="radio" name="scanMode" value="never" data-scan-mode="add"><%= __('librarypaths.scanNever') %></label>
        </div>
        <p class="text-dim lpx-scan-never-hint" style="display:none"><%= __('librarypaths.scanNeverHint') %></p>
      </div>
      <div id="add-scan-custom" class="lpx-scan-custom" style="display:none">
        <div class="field-row">
          <div class="field">
            <label><%= __('schedules.repeatEvery') %></label>
            <input type="number" name="scanRepeatInterval" value="1" min="1" required>
          </div>
          <div class="field">
            <label><%= __('schedules.unit') %></label>
            <select name="scanRepeatUnit">
              <option value="day"><%= __('schedules.unitDay') %></option>
              <option value="week"><%= __('schedules.unitWeek') %></option>
              <option value="month"><%= __('schedules.unitMonth') %></option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label><%= __('schedules.dayOfWeek') %></label>
            <select name="scanDayOfWeek">
              <% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function(d,i){ %>
                <option value="<%= i %>"><%= d %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label><%= __('schedules.hour') %></label>
            <input type="number" name="scanStartTimeHour" value="0" min="0" max="23" required>
          </div>
          <div class="field">
            <label><%= __('schedules.minute') %></label>
            <input type="number" name="scanStartTimeMinute" value="0" min="0" max="59" required>
          </div>
        </div>
        <div class="field">
          <label><%= __('schedules.duration') %></label>
          <input type="number" name="scanDurationMinutes" value="60" min="1" required>
        </div>
        <div class="field">
          <label><%= __('schedules.firstStartDate') %></label>
          <input type="date" name="scanFirstStartAt">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('add-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('librarypaths.addPathBtn') %></button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="edit-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal lpx-modal-480">
    <div class="modal-header">
      <h2><%= __('librarypaths.editPathTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('edit-modal')">✕</button>
    </div>
    <form method="POST" id="edit-form" action="">
      <div class="field">
        <label for="edit-name"><%= __('common.name') %></label>
        <input type="text" id="edit-name" name="name" required>
      </div>
      <div class="field">
        <label for="edit-path"><%= __('librarypaths.filesystemPath') %></label>
        <div class="lpx-path-input-row">
          <input type="text" id="edit-path" name="path" required class="lpx-flex1">
          <button type="button" class="btn btn-secondary lpx-flex-shrink0"
                  onclick="openDirBrowser('edit-path')"><%= __('librarypaths.browse') %></button>
        </div>
        <div id="edit-path-browser-anchor"></div>
      </div>
      <div class="field">
        <label for="edit-type"><%= __('librarypaths.type') %></label>
        <select id="edit-type" name="type" required>
          <option value="movie"><%= __('librarypaths.movie') %></option>
          <option value="series"><%= __('librarypaths.series') %></option>
        </select>
      </div>
      <div class="field">
        <label for="edit-sourceLangId"><%= __('librarypaths.sourceLanguage') %></label>
        <select id="edit-sourceLangId" name="sourceLangId" required>
          <% languages.forEach(function(l) { %>
            <option value="<%= l.id %>"><%= l.flag ? l.flag + ' ' : '' %><%= l.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" id="edit-enabled" name="enabled" value="1">
        <label for="edit-enabled"><%= __('librarypaths.enabledBadge') %></label>
      </div>
      <div class="field field-checkbox" style="display:none">
        <input type="checkbox" id="edit-autoTranslate" name="autoTranslate" value="1">
        <label for="edit-autoTranslate"><%= __('librarypaths.autoTranslate') %></label>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" id="edit-autoExtract" name="autoExtract" value="1">
        <label for="edit-autoExtract"><%= __('librarypaths.autoExport') %></label>
      </div>
      <div class="field">
        <label><%= __('librarypaths.scanFrequency') %></label>
        <div class="lpx-scan-radios">
          <label class="lpx-radio"><input type="radio" name="scanMode" value="hourly" data-scan-mode="edit"><%= __('librarypaths.scanHourly') %></label>
          <label class="lpx-radio"><input type="radio" name="scanMode" value="custom" data-scan-mode="edit"><%= __('librarypaths.scanCustom') %></label>
          <label class="lpx-radio"><input type="radio" name="scanMode" value="never" data-scan-mode="edit"><%= __('librarypaths.scanNever') %></label>
        </div>
        <p class="text-dim lpx-scan-never-hint" style="display:none"><%= __('librarypaths.scanNeverHint') %></p>
      </div>
      <div id="edit-scan-custom" class="lpx-scan-custom" style="display:none"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('common.save') %></button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="blacklist-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal lpx-modal-480">
    <div class="modal-header">
      <h2><%= __('librarypaths.blacklistTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('blacklist-modal')">✕</button>
    </div>
    <form method="POST" id="blacklist-form" action="">
      <p class="text-dim lpx-warn-note">
        <%= __('librarypaths.blacklistWarningPrefix') %> <strong id="blacklist-target-name"></strong> <%= __('librarypaths.blacklistWarningSuffix') %>
      </p>
      <div class="field">
        <label for="blacklist-reason"><%= __('librarypaths.blacklistReason') %></label>
        <input type="text" id="blacklist-reason" name="reason" maxlength="500" placeholder="e.g. wrong language, duplicate, etc.">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('blacklist-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-danger"><%= __('librarypaths.blacklistBtn') %></button>
      </div>
    </form>
  </div>
</div>

<%# ── Per-item change match modal ──────────────────────────────────── %>
<div class="modal-overlay" id="item-match-modal">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2><%= __('librarypaths.changeMatch') %> — <span id="item-match-name"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('item-match-modal')">✕</button>
    </div>
    <p class="text-dim lpx-modal-hint"><%= __('librarypaths.changeMatchItemHint') %></p>
    <div id="item-match-candidates" class="lp-candidate-grid lpx-grid-mb" style="display:none"></div>
    <div class="field">
      <input type="search" id="item-match-search" class="lp-tmdb-search" placeholder="Title…" autocomplete="off">
    </div>
    <div class="lp-tmdb-results lpx-mt-25" id="item-match-results"></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('item-match-modal')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<script src="/app.js"></script>
<script src="/libraryPaths.js"></script>
</body>
</html>
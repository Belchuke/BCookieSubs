    </div>
    <div style="
      padding:.5rem .75rem;
      border-top:1px solid var(--border);
      display:flex;
      justify-content:flex-end;
      gap:.4rem;
    ">
      <button type="button" id="dir-select-btn" class="btn btn-sm btn-primary">
        <%= __('librarypaths.selectThisFolder') %>
      </button>
    </div>
  </div>
</div>


<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('librarypaths.title') %> — BCookieSubs</title>
  <%- include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
  <style>
    summary::-webkit-details-marker { display: none }
    summary { list-style: none }
    details.lp-card[open] .lp-chevron { transform: rotate(180deg) }
    details.series-ep-accordion[open] .series-ep-chevron { transform: rotate(90deg) }
  </style>
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('librarypaths.title') %></h1>
      <button class="btn btn-primary" onclick="openModal('add-modal')"><%= __('librarypaths.addPath') %></button>
    </div>

    <%
      var _missingSrtCount = 0
      var _allGenres = []
      libraryPaths.forEach(function(lp) {
        lp.groups.forEach(function(group) {
          if (group.mediaItem && group.mediaItem.genres) {
            group.mediaItem.genres.split(',').forEach(function(g) {
              var trimmed = g.trim()
              if (trimmed && _allGenres.indexOf(trimmed) === -1) _allGenres.push(trimmed)
            })
          }
          group.items.forEach(function(item) {
            if (item.status === 'no_srts_found' && !item.blacklist) _missingSrtCount++
          })
        })
      })
      _allGenres.sort()
    %>
    <div class="tabs" style="display:flex;gap:.5rem;margin-bottom:1rem;border-bottom:1px solid var(--border)">
      <button type="button" id="lp-tab-btn-library" class="tab-btn active" onclick="lpSwitchTab('library')"><%= __('librarypaths.library') %></button>
      <button type="button" id="lp-tab-btn-missing" class="tab-btn" onclick="lpSwitchTab('missing')">
        <%= __('librarypaths.missingSrts') %><% if (_missingSrtCount > 0) { %> <span class="badge badge-neutral" style="font-size:.7rem"><%= _missingSrtCount %></span><% } %>
      </button>
      <button type="button" id="lp-tab-btn-blacklist" class="tab-btn" onclick="lpSwitchTab('blacklist')"><%= __('librarypaths.blacklistedTab') %></button>
    </div>

    <div id="lp-tab-library">
    <% if (libraryPaths.length === 0) { %>
      <div class="card">
        <p class="empty-state"><%= __('librarypaths.noPathsConfigured') %></p>
      </div>
    <% } else { %>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.75rem;align-items:flex-end">
        <div class="field" style="margin-bottom:0;flex:1;min-width:160px;max-width:420px">
          <input type="search" id="lp-search" placeholder="<%= __('libraryrequests.searchPlaceholder') %>">
        </div>
        <div class="field" style="margin-bottom:0;min-width:140px">
          <select id="lp-genre-filter">
            <option value=""><%= __('libraryrequests.allGenres') %></option>
            <% _allGenres.forEach(function(g) { %>
              <option value="<%= g %>"><%= g %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <% libraryPaths.forEach(function(lp) { %>
        <details class="card lp-card" data-lp-accordion="<%= lp.id %>" style="margin-bottom:1.25rem">
          <summary class="card-header" style="flex-wrap:wrap;gap:.5rem;cursor:pointer">
            <div style="flex:1;min-width:0">
              <%
                var _lpFolderName = lp.path.split('/').filter(Boolean).pop() || lp.path
                var _lpTotalFiles = lp.groups.reduce(function(sum, g) {
                  return sum + g.items.filter(function(i){ return !i.blacklist && i.status !== 'no_srts_found' }).length
                }, 0)
              %>
              <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
                <h2 style="margin:0"><%= lp.name %></h2>
                <span class="badge <%= lp.enabled ? 'badge-success' : 'badge-neutral' %>">
                  <%= lp.enabled ? __('librarypaths.enabledBadge') : __('librarypaths.disabledBadge') %>
                </span>
                <span class="badge badge-neutral"><%= lp.type %></span>
                <span class="badge <%= lp.state === 'scanning' ? 'badge-warning' : lp.state === 'error' ? 'badge-error' : 'badge-neutral' %>" data-lp-state="<%= lp.id %>">
                  <%= lp.state %>
                </span>
              </div>
              <div class="text-dim" style="font-size:.82rem;margin-top:.2rem;word-break:break-all">
                <strong style="color:var(--text)"><%= _lpFolderName %></strong>
                &nbsp;·&nbsp;<%= _lpTotalFiles %> file<%= _lpTotalFiles !== 1 ? 's' : '' %>
              </div>
              <div class="text-dim" style="font-size:.78rem;margin-top:.1rem;word-break:break-all;opacity:.7"><%= lp.path %></div>
              <div class="text-dim" style="font-size:.78rem;margin-top:.15rem">
                <% var sourceLang = languages.find(function(l){ return l.id === lp.sourceLangId }) %>
                Source: <%= sourceLang ? sourceLang.name : 'Unknown' %>
                &nbsp;·&nbsp;
                AutoTranslate: <%= lp.autoTranslate ? 'Yes' : 'No' %>
                &nbsp;·&nbsp;
                AutoExtract: <%= lp.autoExtract ? 'Yes' : 'No' %>
                <% if (lp.lastRunAt) { %>&nbsp;·&nbsp;Last scan: <%= lp.lastRunAt.split(' ')[0] %><% } %>
              </div>
            </div>
            <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
              <i class="fa-solid fa-chevron-down lp-chevron" style="color:var(--text-dim);font-size:.85rem;transition:transform .2s;margin-right:.15rem"></i>
              <button class="btn btn-sm btn-secondary lp-edit-btn"
                      onclick="event.stopPropagation()"
                      data-lp="<%- JSON.stringify({id:lp.id,name:lp.name,path:lp.path,type:lp.type,sourceLangId:lp.sourceLangId,enabled:lp.enabled,autoTranslate:lp.autoTranslate,autoExtract:lp.autoExtract}).replace(/"/g,'&quot;') %>"><%= __('common.edit') %></button>
              <form method="POST" action="/library-paths/toggle/<%= lp.id %>" style="display:inline" onclick="event.stopPropagation()">
                <button type="submit" class="btn btn-sm btn-secondary">
                  <%= lp.enabled ? __('librarypaths.disable') : __('librarypaths.enable') %>
                </button>
              </form>
              <form method="POST" action="/library-paths/delete/<%= lp.id %>" style="display:inline" onclick="event.stopPropagation()"
                    onsubmit="return confirm('Delete library path \'<%= lp.name %>\'? This will also delete all tracked items.')">
                <button type="submit" class="btn btn-sm btn-danger"><%= __('common.delete') %></button>
              </form>
            </div>
          </summary>

          <% if (lp.groups.length === 0) { %>
            <p class="text-dim" style="font-size:.85rem;margin:.75rem 0 0">No items found yet. Scanner will discover files on next run.</p>
          <% } else { %>
            <div style="margin-top:.75rem;display:flex;flex-direction:column;gap:.65rem">
              <% var _groupIdx = 0; lp.groups.forEach(function(group) { _groupIdx++ %>
                <%
                  var _visibleItems = group.items.filter(function(item) {
                    return !item.blacklist && item.status !== 'no_srts_found'
                  })
                  var _allItemIds = group.items.map(function(i) { return i.id })
                  var _blacklistableIds = group.items.filter(function(i) { return !i.blacklist }).map(function(i) { return i.id })
                  var _firstItemId = group.items.length > 0 ? group.items[0].id : null
                  var _groupCandidates = (group.items.length > 0 && group.items[0].candidates) ? group.items[0].candidates : []
                  var _groupKey = 'g' + lp.id + '-' + (group.mediaItemId != null ? group.mediaItemId : 'u' + _groupIdx)
                  var _isSeries = lp.type === 'series'
                  var _lpRootNorm = lp.path.endsWith('/') ? lp.path : lp.path + '/'
                  var _firstItemPath = group.items.length > 0 ? group.items[0].path : ''
                  var _relFirst = _firstItemPath.startsWith(_lpRootNorm) ? _firstItemPath.slice(_lpRootNorm.length) : _firstItemPath.replace(/^\//, '')
                  var _relParts = _relFirst.split('/')
                  var _groupFolderName = _relParts.length > 1 ? _relParts[0] + '/' : ''
                %>
                <% if (_visibleItems.length > 0) { %>
                <div data-lp-group
                  data-search="<%= ((group.mediaItem ? group.mediaItem.title + ' ' + (group.mediaItem.year || '') : 'unmatched') + ' ' + _visibleItems.map(function(i){ return i.path.split('/').pop() }).join(' ')).toLowerCase() %>"
                  data-genre="<%= group.mediaItem && group.mediaItem.genres ? group.mediaItem.genres.toLowerCase() : '' %>"
                  style="border:1px solid var(--border);border-radius:10px;overflow:hidden">

                  <%# ── Group header ─────────────────────────────────────────── %>
                  <div style="display:flex;align-items:flex-start;gap:.85rem;padding:.75rem;background:var(--surface-3)">
                    <% if (showPosters && group.mediaItem && group.mediaItem.mediaItemPhotoPath) { %>
                      <img src="/media-photos/<%= group.mediaItem.mediaItemPhotoPath %>"
                           alt="Poster"
                           style="width:42px;height:63px;object-fit:cover;border-radius:5px;flex-shrink:0">
                    <% } else { %>
                      <div style="width:42px;height:63px;background:var(--surface-2);border-radius:5px;flex-shrink:0;display:flex;align-items:center;justify-content:center">
                        <i class="fa-solid fa-<%= _isSeries ? 'tv' : 'film' %>" style="color:var(--text-dim)"></i>
                      </div>
                    <% } %>
                    <div style="flex:1;min-width:0;padding-top:.1rem">
                      <% if (group.mediaItem) { %>
                        <div style="font-weight:700;font-size:.95rem">
                          <%= group.mediaItem.title %>
                          <% if (group.mediaItem.year) { %>
                            <span class="text-dim" style="font-weight:400;font-size:.82rem">(<%= group.mediaItem.year %>)</span>
                          <% } %>
                        </div>
                        <div class="text-dim" style="font-size:.78rem;margin-top:.1rem">
                          <% if (_groupFolderName) { %><span style="color:var(--text-dim)"><%= _groupFolderName %></span> &ndash; <% } %><%= _visibleItems.length %> file<%= _visibleItems.length !== 1 ? 's' : '' %>
                        </div>
                      <% } else { %>
                        <div style="font-weight:600;font-size:.9rem;color:var(--text-dim)">Unmatched</div>
                        <div class="text-dim" style="font-size:.78rem;margin-top:.1rem">
                          <% if (_groupFolderName) { %><span style="color:var(--text-dim)"><%= _groupFolderName %></span> &ndash; <% } %><%= _visibleItems.length %> file<%= _visibleItems.length !== 1 ? 's' : '' %> — no media match yet
                        </div>
                      <% } %>
                    </div>
                    <div style="display:flex;gap:.35rem;align-items:center;flex-shrink:0;flex-wrap:wrap">
                      <% if (group.mediaItemId) { %>
                        <button type="button" class="btn btn-sm btn-secondary lp-group-match-btn"
                          data-group-key="<%= _groupKey %>">Change Match</button>
                      <% } %>
                      <% if (group.mediaItemId && can('canEditLibraryPath')) { %>
                        <label class="btn btn-sm btn-secondary" style="cursor:pointer;position:relative;margin:0" title="Upload custom poster">
                          <i class="fa-solid fa-image"></i>
                          <input type="file" accept="image/*" class="lp-photo-input"
                                 data-media-item-id="<%= group.mediaItemId %>"
                                 style="position:absolute;opacity:0;width:1px;height:1px;overflow:hidden">
                        </label>
                      <% } %>
                      <% if (can('canBlackListALibraryPathItem') && _blacklistableIds.length > 0) { %>
                        <button type="button" class="btn btn-sm btn-danger lp-blacklist-group-btn"
                          data-item-ids="<%- JSON.stringify(_blacklistableIds) %>"
                          data-group-name="<%= group.mediaItem ? group.mediaItem.title : 'Unmatched group' %>"
                          title="Blacklist all items in this group"><%= __('librarypaths.blacklistBtn') %></button>
                      <% } %>
                    </div>
                  </div>

                  <%# ── Group-level match picker ─────────────────────────────── %>
                  <div id="lp-group-picker-<%= _groupKey %>"
                       style="padding:.65rem .85rem;border-top:1px solid var(--border);background:var(--surface-2)"
                       <% if (group.mediaItemId) { %>hidden<% } %>>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem">
                      <div class="text-dim" style="font-size:.75rem">
                        <%= group.mediaItemId ? 'Change the match:' : 'Select the correct match:' %>
                      </div>
                      <% if (group.mediaItemId) { %>
                        <button type="button" class="btn btn-sm btn-secondary lp-group-match-cancel"
                          data-group-key="<%= _groupKey %>">Cancel</button>
                      <% } %>
                    </div>
                    <% if (_groupCandidates.length > 0) { %>
                    <div class="lp-candidate-grid" style="margin-bottom:.5rem">
                      <% _groupCandidates.forEach(function(c) { %>
                        <button type="button" class="btn btn-secondary lp-select-group-candidate-btn"
                          data-group-key="<%= _groupKey %>"
                          data-item-ids="<%- JSON.stringify(_allItemIds) %>"
                          data-media-item-id="<%= c.mediaItemId %>"
                          style="display:flex;flex-direction:row;align-items:center;gap:.75rem;padding:.6rem .75rem;height:auto;width:100%;text-align:left"
                        >
                          <% if (showPosters && c.mediaPoster) { %>
                            <img src="/media-photos/<%= c.mediaPoster %>"
                                 alt="Poster"
                                 style="width:54px;height:81px;object-fit:cover;border-radius:4px;flex-shrink:0">
                          <% } else { %>
                            <div style="width:54px;height:81px;background:var(--surface-2);border-radius:4px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                              <i class="fa-solid fa-film" style="font-size:1.4rem;color:var(--text-dim)"></i>
                            </div>
                          <% } %>
                          <span style="font-size:.88rem;line-height:1.35;word-break:break-word;min-width:0">
                            <strong><%= c.mediaTitle || 'Unknown' %></strong><br><span class="text-dim" style="font-size:.8rem">(<%= c.mediaYear || 'year unknown' %>)</span>
                          </span>
                        </button>
                      <% }) %>
                    </div>
                    <% } %>
                    <div style="border-top:1px dashed var(--border);padding-top:.45rem">
                      <div class="field" style="margin-bottom:.35rem">
                        <input type="search" class="lp-tmdb-search"
                          data-item-id="<%= _firstItemId %>"
                          data-item-ids="<%- JSON.stringify(_allItemIds) %>"
                          data-group-key="<%= _groupKey %>"
                          data-type="<%= lp.type %>"
                          placeholder="Search TheMovieDB…">
                      </div>
                      <div class="lp-tmdb-results" data-item-id="<%= _firstItemId %>" data-group-key="<%= _groupKey %>"></div>
                    </div>
                  </div>

                  <%# ── File / episode list ─────────────────────────────────── %>
                  <% if (_isSeries) { %>
                    <details class="series-ep-accordion" data-ep-accordion="<%= _groupKey %>">
                      <summary style="
                        cursor:pointer;
                        padding:.5rem .85rem;
                        border-top:1px solid var(--border);
                        display:flex;
                        align-items:center;
                        gap:.5rem;
                        background:var(--surface-2);
                        user-select:none;
                      ">
                        <i class="fa-solid fa-chevron-right series-ep-chevron" style="font-size:.72rem;color:var(--text-dim);transition:transform .2s;flex-shrink:0"></i>
                        <span class="text-dim" style="font-size:.81rem">
                          <%= _visibleItems.length %> episode<%= _visibleItems.length !== 1 ? 's' : '' %>
                        </span>
                      </summary>
                      <div style="display:flex;flex-direction:column">
                        <% _visibleItems.forEach(function(item) { %>
                          <%
                            var _si = item.subtitleInfo
                            var _translationDeleted = _si && (_si.deleted || _si.activeJobs.length === 0)
                            var _activeJobs = (_si && !_si.deleted) ? _si.activeJobs : []
                            var _hasRunning = _activeJobs.some(function(j){ return j.jobStatus === 'running' })
                            var _hasFailed  = _activeJobs.some(function(j){ return j.jobStatus === 'failed'  })
                            var _jobLabel   = _hasRunning ? 'Translating' : _hasFailed ? 'Failed' : 'Queued'
                            var _langList   = _activeJobs.map(function(j){
                              return (j.langFlag ? j.langFlag + ' ' : '') + j.langIso.toUpperCase()
                            }).join(', ')
                          %>
                          <div data-item-row="<%= item.id %>" style="
                            padding:.6rem .85rem;
                            border-top:1px solid var(--border);
                            display:flex;flex-direction:column;gap:.35rem
                          ">
                            <div style="min-width:0">
                              <div style="display:flex;align-items:center;gap:.4rem">
                                <% if (item.season !== null && item.episode !== null) { %>
                                  <span style="font-weight:600;font-size:.85rem;flex-shrink:0">
                                    S<%= String(item.season).padStart(2,'0') %>E<%= String(item.episode).padStart(2,'0') %>
                                  </span>
                                <% } %>
                                <span style="font-size:.82rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1" title="<%= item.path %>">
                                  <%= item.path.split('/').pop() %>
                                </span>
                              </div>
                              <div style="display:flex;gap:.35rem;margin-top:.2rem;flex-wrap:wrap;align-items:center">
                                <span class="badge <%= item.status === 'completed' ? 'badge-success' : item.status === 'failed' ? 'badge-error' : item.status === 'queued' ? 'badge-warning' : 'badge-neutral' %>" style="font-size:.7rem" data-item-status="<%= item.id %>">
                                  <%= item.status.replace(/_/g,' ') %>
                                </span>
                                <% if (_translationDeleted) { %>
                                  <span class="badge badge-error" style="font-size:.7rem">Translation deleted</span>
                                <% } else if (_activeJobs.length > 0) { %>
                                  <span class="text-dim" style="font-size:.75rem"><%= _jobLabel %> · <%= _langList %></span>
                                <% } %>
                              </div>
                            </div>
                            <div style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;justify-content:flex-end">
                              <% if (item.blacklist) { %>
                                <span class="badge badge-warning" style="font-size:.7rem" title="<%= item.blacklist.reason || '' %>">Blacklisted</span>
                                <% if (can('canBlackListALibraryPathItem')) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/unblacklist" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-secondary"><%= __('librarypaths.removeFromBlacklist') %></button>
                                  </form>
                                <% } %>
                              <% } else { %>
                                <% if (_translationDeleted && can('canAddSubtitleToTranslateFromLibrary')) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/readd" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-secondary"><%= __('librarypaths.readd') %></button>
                                  </form>
                                <% } else if (can('canAddSubtitleToTranslateFromLibrary') && !_translationDeleted && item.status !== 'queued' && item.status !== 'completed' && item.status !== 'no_srts_found' && (item.candidates.length === 0 || item.mediaItemId)) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/translate" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-primary"><%= __('librarypaths.translate') %></button>
                                  </form>
                                <% } %>
                                <% if (can('canBlackListALibraryPathItem')) { %>
                                  <button type="button" class="btn btn-sm btn-secondary lp-blacklist-btn"
                                          data-item-id="<%= item.id %>"
                                          data-item-name="<%= item.path.split('/').pop() %>"
                                          title="Block this item from translation"><%= __('librarypaths.blacklistBtn') %></button>
                                <% } %>
                              <% } %>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </details>
                  <% } else { %>
                    <details class="series-ep-accordion" data-ep-accordion="<%= _groupKey %>">
                      <summary style="
                        cursor:pointer;
                        padding:.5rem .85rem;
                        border-top:1px solid var(--border);
                        display:flex;
                        align-items:center;
                        gap:.5rem;
                        background:var(--surface-2);
                        user-select:none;
                      ">
                        <i class="fa-solid fa-chevron-right series-ep-chevron" style="font-size:.72rem;color:var(--text-dim);transition:transform .2s;flex-shrink:0"></i>
                        <span class="text-dim" style="font-size:.81rem">
                          <%= _visibleItems.length %> translation track<%= _visibleItems.length !== 1 ? 's' : '' %>
                        </span>
                      </summary>
                      <div style="display:flex;flex-direction:column">
                        <% _visibleItems.forEach(function(item) { %>
                          <%
                            var _si = item.subtitleInfo
                            var _translationDeleted = _si && (_si.deleted || _si.activeJobs.length === 0)
                            var _activeJobs = (_si && !_si.deleted) ? _si.activeJobs : []
                            var _hasRunning = _activeJobs.some(function(j){ return j.jobStatus === 'running' })
                            var _hasFailed  = _activeJobs.some(function(j){ return j.jobStatus === 'failed'  })
                            var _jobLabel   = _hasRunning ? 'Translating' : _hasFailed ? 'Failed' : 'Queued'
                            var _langList   = _activeJobs.map(function(j){
                              return (j.langFlag ? j.langFlag + ' ' : '') + j.langIso.toUpperCase()
                            }).join(', ')
                          %>
                          <div data-item-row="<%= item.id %>" style="
                            padding:.6rem .85rem;
                            border-top:1px solid var(--border);
                            display:flex;flex-direction:column;gap:.35rem
                          ">
                            <div style="min-width:0">
                              <div style="display:flex;align-items:center;gap:.4rem">
                                <span style="font-size:.82rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1" title="<%= item.path %>">
                                  <%= item.path.split('/').pop() %>
                                </span>
                              </div>
                              <div style="display:flex;gap:.35rem;margin-top:.2rem;flex-wrap:wrap;align-items:center">
                                <span class="badge <%= item.status === 'completed' ? 'badge-success' : item.status === 'failed' ? 'badge-error' : item.status === 'queued' ? 'badge-warning' : 'badge-neutral' %>" style="font-size:.7rem" data-item-status="<%= item.id %>">
                                  <%= item.status.replace(/_/g,' ') %>
                                </span>
                                <% if (_translationDeleted) { %>
                                  <span class="badge badge-error" style="font-size:.7rem">Translation deleted</span>
                                <% } else if (_activeJobs.length > 0) { %>
                                  <span class="text-dim" style="font-size:.75rem"><%= _jobLabel %> · <%= _langList %></span>
                                <% } %>
                              </div>
                            </div>
                            <div style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;justify-content:flex-end">
                              <% if (item.blacklist) { %>
                                <span class="badge badge-warning" style="font-size:.7rem" title="<%= item.blacklist.reason || '' %>">Blacklisted</span>
                                <% if (can('canBlackListALibraryPathItem')) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/unblacklist" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-secondary"><%= __('librarypaths.removeFromBlacklist') %></button>
                                  </form>
                                <% } %>
                              <% } else { %>
                                <% if (_translationDeleted && can('canAddSubtitleToTranslateFromLibrary')) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/readd" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-secondary"><%= __('librarypaths.readd') %></button>
                                  </form>
                                <% } else if (can('canAddSubtitleToTranslateFromLibrary') && !_translationDeleted && item.status !== 'queued' && item.status !== 'completed' && item.status !== 'no_srts_found' && (item.candidates.length === 0 || item.mediaItemId)) { %>
                                  <form method="POST" action="/library-paths/item/<%= item.id %>/translate" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-primary"><%= __('librarypaths.translate') %></button>
                                  </form>
                                <% } %>
                                <% if (can('canBlackListALibraryPathItem')) { %>
                                  <button type="button" class="btn btn-sm btn-secondary lp-blacklist-btn"
                                          data-item-id="<%= item.id %>"
                                          data-item-name="<%= item.path.split('/').pop() %>"
                                          title="Block this item from translation"><%= __('librarypaths.blacklistBtn') %></button>
                                <% } %>
                              <% } %>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </details>
                  <% } %>

                </div>
                <% } %>
              <% }) %>
            </div>
          <% } %>
        </details>
      <% }) %>
    <% } %>
    </div>

    <div id="lp-tab-missing" style="display:none">
      <% if (_missingSrtCount === 0) { %>
        <div class="card">
          <p class="empty-state"><%= __('librarypaths.noMissingSrts') %></p>
        </div>
      <% } else { %>
        <% libraryPaths.forEach(function(lp) { %>
          <%
            var _missItems = []
            lp.groups.forEach(function(group) {
              group.items.forEach(function(item) {
                if (item.status === 'no_srts_found' && !item.blacklist) _missItems.push(item)
              })
            })
          %>
          <% if (_missItems.length > 0) { %>
            <div class="card" style="margin-bottom:1.25rem">
              <div class="card-header" style="flex-wrap:wrap;gap:.5rem">
                <h2 style="margin:0"><%= lp.name %></h2>
                <span class="badge badge-neutral"><%= _missItems.length %> item<%= _missItems.length !== 1 ? 's' : '' %></span>
              </div>
              <div style="display:flex;flex-direction:column">
                <% _missItems.forEach(function(item) { %>
                  <div style="padding:.6rem .85rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
                    <div style="flex:1;min-width:0">
                      <span style="font-size:.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block" title="<%= item.path %>">
                        <%= item.path.split('/').pop() %>
                      </span>
                      <span class="badge badge-neutral" style="font-size:.7rem;margin-top:.25rem;display:inline-block"><%= __('librarypaths.noSrtsFound') %></span>
                    </div>
                    <div style="display:flex;gap:.35rem;align-items:center;flex-shrink:0">
                      <% if (can('canBlackListALibraryPathItem')) { %>
                        <button type="button" class="btn btn-sm btn-secondary lp-blacklist-btn"
                                data-item-id="<%= item.id %>"
                                data-item-name="<%= item.path.split('/').pop() %>"
                                title="Block this item from translation"><%= __('librarypaths.blacklistBtn') %></button>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <div id="lp-tab-blacklist" style="display:none">
      <div class="card">
        <% if (!blacklisted || blacklisted.length === 0) { %>
          <p class="empty-state"><%= __('librarypaths.noBlacklisted') %></p>
        <% } else { %>
          <div style="overflow-x:auto">
            <table class="table" style="width:100%;border-collapse:collapse">
              <thead>
                <tr style="text-align:left;border-bottom:1px solid var(--border)">
                  <th style="padding:.5rem .35rem"><%= __('librarypaths.filesystemPath') %></th>
                  <th style="padding:.5rem .35rem"><%= __('librarypaths.library') %></th>
                  <th style="padding:.5rem .35rem"><%= __('common.match') %></th>
                  <th style="padding:.5rem .35rem"><%= __('librarypaths.blacklistedBy') %></th>
                  <th style="padding:.5rem .35rem"><%= __('common.when') %></th>
                  <th style="padding:.5rem .35rem"><%= __('librarypaths.blacklistReason') %></th>
                  <% if (can('canBlackListALibraryPathItem')) { %>
                    <th style="padding:.5rem .35rem"><%= __('common.actions') %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% blacklisted.forEach(function(b) { %>
                  <tr style="border-bottom:1px solid var(--border)">
                    <td style="padding:.55rem .35rem;max-width:340px;word-break:break-all">
                      <% var _fileName = b.itemPath.split('/').pop() %>
                      <div style="font-weight:600;font-size:.88rem"><%= _fileName %></div>
                      <% if (b.season !== null && b.episode !== null) { %>
                        <div class="text-dim" style="font-size:.75rem">
                          S<%= String(b.season).padStart(2,'0') %>E<%= String(b.episode).padStart(2,'0') %>
                        </div>
                      <% } %>
                      <div class="text-dim" style="font-size:.72rem;margin-top:.15rem"><%= b.itemPath %></div>
                    </td>
                    <td style="padding:.55rem .35rem"><%= b.libraryPathName || '—' %></td>
                    <td style="padding:.55rem .35rem">
                      <% if (b.mediaTitle) { %>
                        <%= b.mediaTitle %><% if (b.mediaYear) { %> <span class="text-dim">(<%= b.mediaYear %>)</span><% } %>
                      <% } else { %>
                        <span class="text-dim">Unmatched</span>
                      <% } %>
                    </td>
                    <td style="padding:.55rem .35rem"><%= b.blacklistedByUsername || '—' %></td>
                    <td style="padding:.55rem .35rem;white-space:nowrap"><%= b.createdAt %></td>
                    <td style="padding:.55rem .35rem;max-width:280px;word-break:break-word">
                      <% if (b.reason) { %><%= b.reason %><% } else { %><span class="text-dim">—</span><% } %>
                    </td>
                    <% if (can('canBlackListALibraryPathItem')) { %>
                      <td style="padding:.55rem .35rem;white-space:nowrap">
                        <form method="POST" action="/library-paths/item/<%= b.libraryPathItemId %>/unblacklist?from=blacklist" style="display:inline">
                          <button type="submit" class="btn btn-sm btn-secondary"><%= __('librarypaths.removeFromBlacklist') %></button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
<div id="lp-config" data-show-posters="<%= showPosters ? '1' : '0' %>" hidden></div>

<div id="dir-browser-panel" style="display:none;margin-top:.5rem">
  <div style="
    border:1px solid var(--border);
    border-radius:8px;
    overflow:hidden;
    background:var(--surface-2);
    font-size:.85rem;
  ">
    <div style="
      display:flex;
      align-items:center;
      gap:.4rem;
      padding:.5rem .75rem;
      border-bottom:1px solid var(--border);
      background:var(--surface-3);
      flex-wrap:wrap;
      min-height:2.4rem;
    ">
      <button type="button" id="dir-up-btn"
        class="btn btn-icon btn-sm"
        style="flex-shrink:0;padding:.2rem .45rem;font-size:.8rem"
        title="Go up">↑</button>
      <span id="dir-current-path"
        class="text-dim"
        style="font-size:.78rem;word-break:break-all;flex:1;min-width:0"></span>
    </div>
    <div id="dir-list"
      style="
        max-height:220px;
        overflow-y:auto;
        display:flex;
        flex-direction:column;
      ">

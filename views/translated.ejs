<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('translated.title') %> — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('translated.title') %></h1>
    </div>

    <% if (subtitles.length === 0) { %>
      <div class="card">
        <p class="empty-state"><%= __('translated.noFinishedSubtitles') %></p>
      </div>
    <% } else { %>
      <div class="card">
        
        <div class="table-wrap translated-table-wrap">
          <table>
            <thead>
              <tr>
                <% if (config.showPosters && user.showPosters !== 0) { %><th style="width:50px"></th><% } %>
                <th><%= __('translated.titleHeader') %></th>
                <th><%= __('translated.source') %></th>
                <th><%= __('translated.target') %></th>
                <th class="num"><%= __('translated.episode') %></th>
                <th class="num"><%= __('translated.year') %></th>
                <th><%= __('translated.finished') %></th>
                <th><%= __('translated.duration') %></th>
                <th style="width:1px"></th>
              </tr>
            </thead>
            <tbody>
              <% subtitles.forEach(function(sub) { %>
              <tr>
                <% if (config.showPosters && user.showPosters !== 0) { %>
                <td style="padding:.5rem .75rem">
                  <% if (sub.mediaItemPhotoPath) { %>
                    <img src="/media-photos/<%= sub.mediaItemPhotoPath %>" alt="" class="translated-poster">
                  <% } else { %>
                    <div class="translated-poster-placeholder"></div>
                  <% } %>
                </td>
                <% } %>
                <td class="job-name"><%= sub.subtitleName %></td>
                <td><span class="badge badge-neutral"><%= sub.sourceLang %></span></td>
                <td><span class="badge badge-success"><%= sub.targetLang %></span></td>
                <td class="num">
                  <% if (sub.season !== null && sub.episode !== null) { %>
                    S<%= String(sub.season).padStart(2, '0') %>E<%= String(sub.episode).padStart(2, '0') %>
                  <% } else { %>
                    <span class="text-dim">—</span>
                  <% } %>
                </td>
                <td class="num"><%= sub.year !== null ? sub.year : '<span class="text-dim">—</span>' %></td>
                <td class="text-dim" style="white-space:nowrap">
                  <span data-utc="<%= sub.finishedAt || '' %>">—</span>
                </td>
                <td class="text-dim" style="white-space:nowrap">
                  <span data-duration-start="<%= sub.earliestChunkStartedAt || '' %>" data-duration-end="<%= sub.finishedAt || '' %>">—</span>
                </td>
                <td>
                  <a href="/dashboard/download/<%= sub.jobId %>" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-download"></i> Export
                  </a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        
        <div class="translated-cards">
          <% subtitles.forEach(function(sub) { %>
          <div class="translated-card">
            <% if (config.showPosters && user.showPosters !== 0 && sub.mediaItemPhotoPath) { %>
              <img src="/media-photos/<%= sub.mediaItemPhotoPath %>" alt="" class="translated-card-poster">
            <% } %>
            <div class="translated-card-body">
              <div class="translated-card-title"><%= sub.subtitleName %></div>
              <div class="translated-card-meta">
                <span class="badge badge-neutral"><%= sub.sourceLang %></span>
                <i class="fa-solid fa-arrow-right" style="font-size:.7rem;color:var(--text-dim)"></i>
                <span class="badge badge-success"><%= sub.targetLang %></span>
                <% if (sub.season !== null && sub.episode !== null) { %>
                  <span class="badge badge-info">S<%= String(sub.season).padStart(2,'0') %>E<%= String(sub.episode).padStart(2,'0') %></span>
                <% } %>
                <% if (sub.year) { %><span class="text-dim" style="font-size:.82rem"><%= sub.year %></span><% } %>
                <% if (sub.finishedAt) { %>
                  <span class="text-dim" style="font-size:.78rem">Finished: <span data-utc="<%= sub.finishedAt %>">—</span></span>
                <% } %>
                <% if (sub.earliestChunkStartedAt && sub.finishedAt) { %>
                  <span class="text-dim" style="font-size:.78rem">Duration: <span data-duration-start="<%= sub.earliestChunkStartedAt %>" data-duration-end="<%= sub.finishedAt %>">—</span></span>
                <% } %>
              </div>
              <a href="/dashboard/download/<%= sub.jobId %>" class="btn btn-primary btn-sm" style="margin-top:.5rem;align-self:flex-start">
                <i class="fa-solid fa-download"></i> Export
              </a>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </main>
</div>
<script src="/app.js"></script>
<script>
  (function () {
    function parseUtc(s) {
      if (!s) return null
      var d = new Date(s.replace(' ', 'T') + 'Z')
      return isNaN(d.getTime()) ? null : d
    }
    document.querySelectorAll('[data-utc]').forEach(function (el) {
      var d = parseUtc(el.getAttribute('data-utc'))
      el.textContent = d ? d.toLocaleString() : '—'
    })
    document.querySelectorAll('[data-duration-start]').forEach(function (el) {
      var start = parseUtc(el.getAttribute('data-duration-start'))
      var end = parseUtc(el.getAttribute('data-duration-end'))
      if (!start || !end) { el.textContent = '—'; return }
      var sec = Math.round((end - start) / 1000)
      if (sec < 0) { el.textContent = '—'; return }
      var h = Math.floor(sec / 3600)
      var m = Math.floor((sec % 3600) / 60)
      var s = sec % 60
      var parts = []
      if (h > 0) parts.push(h + 'h')
      if (m > 0) parts.push(m + 'm')
      parts.push(s + 's')
      el.textContent = parts.join(' ')
    })
  })()
</script>
</body>
</html>

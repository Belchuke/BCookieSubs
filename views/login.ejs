<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('login.title') %> — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="lgn-logo-wrap">
      <img class="lgn-logo auth-logo" src="/images/icon.png" alt="BCookieSubs logo">
    </div>
    <h1 class="auth-title">BCookieSubs</h1>
    <p class="auth-subtitle">Sign in to continue</p>

    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login<%= typeof req !== 'undefined' && req.query.next ? '?next=' + encodeURIComponent(req.query.next) : '' %>">
      <div class="field">
        <label for="username"><%= __('login.username') %></label>
        <input type="text" id="username" name="username" autocomplete="username" autofocus required>
      </div>
      <div class="field">
        <label for="password"><%= __('login.password') %></label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full"><%= __('login.signIn') %></button>
    </form>
  </div>
</body>
</html>

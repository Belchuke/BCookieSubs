<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup — Default Languages</title>
  <%-  include('../theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="setup-page" style="max-width:680px">
  <div class="setup-steps">
    <span class="step done">✓</span>
    <span class="step-line done"></span>
    <span class="step done">✓</span>
    <span class="step-line done"></span>
    <span class="step active">3</span>
    <span class="step-line"></span>
    <span class="step">4</span>
    <span class="step-line"></span>
    <span class="step">5</span>
  </div>
  <h1><%= __('setup.step3.title') %></h1>
  <p class="page-subtitle"><%= __('setup.step3.subtitle') %></p>

  <% if (locals.error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="card" style="margin-bottom:1.5rem">
    <div class="card-header">
      <h2><%= __('setup.step3.selectedLangs') %></h2>
      <small class="text-dim" id="selected-count"><%= __('setup.step3.selectedCount').replace('{{count}}', 0) %></small>
    </div>

    <div id="selected-list" style="display:flex;flex-direction:column;gap:0"></div>

    <p id="empty-msg" class="empty-state"><%= __('setup.step3.empty') %></p>

    <div style="display:flex;gap:.5rem;align-items:flex-end;padding:.75rem 0 0;margin-top:.5rem" id="add-row">
      <div class="field" style="flex:1;margin:0">
        <label for="lang-select"><%= __('setup.step3.addLang') %></label>
        <select id="lang-select">
          <% languages.forEach(function(l) { %>
            <option value="<%= l.id %>" data-name="<%= l.name %>" data-flag-code="<%= l.flagCode || '' %>">
              <%= l.name %>
            </option>
          <% }) %>
        </select>
      </div>
      <button type="button" class="btn btn-primary" id="add-lang-btn">Add</button>
    </div>
  </div>

  <form method="POST" action="/setup/3/next" id="lang-form">
    <div id="hidden-inputs"></div>
    <div class="setup-actions">
      <button type="submit" class="btn btn-primary" id="continue-btn" disabled title="<%= __('setup.step3.minOneError') %>">
        <%= __('setup.step3.submit') %> →
      </button>
    </div>
  </form>
</div>

<script>
  var selected = []; // [{id, name, flagCode}]

  var selectedList = document.getElementById('selected-list');
  var emptyMsg = document.getElementById('empty-msg');
  var selectedCount = document.getElementById('selected-count');
  var hiddenInputs = document.getElementById('hidden-inputs');
  var continueBtn = document.getElementById('continue-btn');
  var langSelect = document.getElementById('lang-select');

  function render() {
    selectedList.innerHTML = '';
    hiddenInputs.innerHTML = '';

    emptyMsg.style.display = selected.length === 0 ? '' : 'none';
    selectedCount.textContent = selected.length + ' selected';
    continueBtn.disabled = selected.length === 0;
    if (selected.length > 0) continueBtn.removeAttribute('title');
    else continueBtn.setAttribute('title', 'Add at least one language');

    selected.forEach(function(lang, idx) {
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:.5rem;padding:.4rem 0;border-bottom:1px solid var(--border)';

      row.innerHTML =
        '<span class="text-dim" style="width:1.5rem;text-align:right;font-size:.8rem">' + (idx + 1) + '.</span>' +
        '<span style="flex:1">' + (lang.flagCode ? '<span class="fi fi-' + lang.flagCode + '"></span> ' : '') + escHtml(lang.name) + '</span>' +
        '<button type="button" class="btn btn-sm btn-danger" data-idx="' + idx + '">✕</button>';
        
      selectedList.appendChild(row);

      var inp = document.createElement('input');
      inp.type = 'hidden';
      inp.name = 'languageId';
      inp.value = lang.id;
      hiddenInputs.appendChild(inp);
    });

    selectedList.querySelectorAll('[data-idx]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selected.splice(parseInt(btn.dataset.idx), 1);
        render();
      });
    });
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  document.getElementById('add-lang-btn').addEventListener('click', function() {
    var opt = langSelect.options[langSelect.selectedIndex];
    var id = parseInt(opt.value);
    if (selected.some(function(l){ return l.id === id })) return;
    selected.push({ id: id, name: opt.dataset.name, flagCode: opt.dataset.flagCode });
    render();
  });

  render();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup — BCookieSubs</title>
    <%-  include('../theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <div class="auth-card" style="max-width:440px">
    <div style="padding-left: 3rem; padding-right: 3rem;">
      <div class="setup-steps">
        <span class="step active">1</span>
        <span class="step-line"></span>
        <span class="step">2</span>
        <span class="step-line"></span>
        <span class="step">3</span>
        <span class="step-line"></span>
        <span class="step">4</span>
        <span class="step-line"></span>
        <span class="step">5</span>
      </div>
    </div>

    <div class="auth-logo">🔐</div>
    <h1 class="auth-title"><%= __('setup.step1.title') %></h1>
    <p class="auth-subtitle"><%= __('setup.step1.subtitle') %></p>

    <% if (locals.error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/setup/1">
      <div class="field">
        <label for="username"><%= __('setup.step1.username') %></label>
        <input type="text" id="username" name="username" autocomplete="username" autofocus required>
      </div>
      <div class="field">
        <label for="password"><%= __('setup.step1.password') %> <span class="hint"><%= __('setup.step1.passwordHint') %></span></label>
        <input type="password" id="password" name="password" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="password2"><%= __('setup.step1.confirmPassword') %></label>
        <input type="password" id="password2" name="password2" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full"><%= __('setup.step1.submit') %></button>
    </form>
  </div>
</body>
</html>

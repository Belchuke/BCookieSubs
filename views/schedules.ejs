<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Schedules — BCookieSubs</title>
  <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1>Schedules</h1>
      <% if (user.isAdmin || user.canManageSchedules) { %>
        <button class="btn btn-primary" onclick="openModal('add-schedule-modal')">+ Add</button>
      <% } %>
    </div>

    <div class="card">
      <% if (schedules.length === 0) { %>
        <p class="empty-state">No schedules configured. Add one to gate translation to specific time windows.</p>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:.75rem">
          <% var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] %>
          <% schedules.forEach(function(s) { %>
            <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.75rem 1rem">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem">
                <strong><%= s.taskName %></strong>
                <div style="display:flex;gap:.4rem;align-items:center">
                  <span class="badge <%= s.enabled ? 'badge-success' : 'badge-neutral' %>"><%= s.enabled ? 'On' : 'Off' %></span>
                  <% if (user.isAdmin || user.canManageSchedules) { %>
                  <button class="btn btn-sm btn-secondary sched-edit-btn"
                          data-sched="<%- JSON.stringify(s).replace(/"/g, '&quot;') %>">Edit</button>
                  <form method="POST" action="/schedules/delete/<%= s.id %>" style="display:inline"
                        class="sched-delete-form">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                  <% } %>
                </div>
              </div>
              <div class="text-dim" style="font-size:.82rem">
                Every <%= s.repeatInterval %> <%= s.repeatUnit %><%= s.repeatInterval > 1 ? 's' : '' %>
                <% if (s.repeatUnit === 'week') { %> on <%= days[s.dayOfTheWeek] %><% } %>,
                starting <%= String(s.startTimeHour).padStart(2,'0') %>:<%= String(s.startTimeMinute).padStart(2,'0') %>
                for <%= s.durationMinutes %> min
                <% if (s.lastRunAt) { %> · last run <%= s.lastRunAt.split(' ')[0] %><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<% if (user.isAdmin || user.canManageSchedules) { %>
<div class="modal-overlay" id="add-schedule-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2>Add Schedule</h2>
      <button class="btn btn-icon" onclick="closeModal('add-schedule-modal')">✕</button>
    </div>
    <form method="POST" action="/schedules/add">
      <div class="field">
        <label>Task Name</label>
        <input type="text" name="taskName" value="translation" required>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" name="enabled" value="1" id="as-enabled" checked>
        <label for="as-enabled">Enabled</label>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Repeat Every</label>
          <input type="number" name="repeatInterval" value="1" min="1" required>
        </div>
        <div class="field">
          <label>Unit</label>
          <select name="repeatUnit">
            <option value="day">Day</option>
            <option value="week" selected>Week</option>
            <option value="month">Month</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Day of Week</label>
          <select name="dayOfTheWeek">
            <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(d,i){ %>
              <option value="<%= i %>"><%= d %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Hour (0–23)</label>
          <input type="number" name="startTimeHour" value="8" min="0" max="23" required>
        </div>
        <div class="field">
          <label>Minute (0–59)</label>
          <input type="number" name="startTimeMinute" value="0" min="0" max="59" required>
        </div>
      </div>
      <div class="field">
        <label>Duration (minutes)</label>
        <input type="number" name="durationMinutes" value="60" min="1" required>
      </div>
      <div class="field">
        <label>First Start Date</label>
        <input type="date" name="firstStartAt">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('add-schedule-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Schedule</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="edit-schedule-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Schedule</h2>
      <button class="btn btn-icon" onclick="closeModal('edit-schedule-modal')">✕</button>
    </div>
    <form method="POST" id="edit-sched-form" action="">
      <div id="edit-sched-fields"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-schedule-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script src="/app.js"></script>
<script>
  document.querySelectorAll('.sched-delete-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm('Delete this schedule?')) e.preventDefault();
    });
  });

  <% if (user.isAdmin || user.canManageSchedules) { %>
  var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  document.querySelectorAll('.sched-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var s = JSON.parse(btn.dataset.sched);
      document.getElementById('edit-sched-form').action = '/schedules/update/' + s.id;
      document.getElementById('edit-sched-fields').innerHTML = buildSchedFields(s);
      openModal('edit-schedule-modal');
    });
  });

  function buildSchedFields(s) {
    var units = ['day','week','month'];
    var html = '';
    html += '<div class="field"><label>Task Name</label>';
    html += '<input type="text" name="taskName" value="' + esc(s.taskName) + '" required></div>';
    html += '<div class="field field-checkbox"><input type="checkbox" name="enabled" value="1" id="es-en" ' + (s.enabled ? 'checked' : '') + '>';
    html += '<label for="es-en">Enabled</label></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>Every</label><input type="number" name="repeatInterval" value="' + s.repeatInterval + '" min="1" required></div>';
    html += '<div class="field"><label>Unit</label><select name="repeatUnit">';
    units.forEach(function(u) { html += '<option value="' + u + '"' + (s.repeatUnit === u ? ' selected' : '') + '>' + u + '</option>'; });
    html += '</select></div></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>Day of Week</label><select name="dayOfTheWeek">';
    DAYS.forEach(function(d, i) { html += '<option value="' + i + '"' + (s.dayOfTheWeek === i ? ' selected' : '') + '>' + d + '</option>'; });
    html += '</select></div>';
    html += '<div class="field"><label>Hour (0–23)</label><input type="number" name="startTimeHour" value="' + s.startTimeHour + '" min="0" max="23" required></div>';
    html += '<div class="field"><label>Minute (0–59)</label><input type="number" name="startTimeMinute" value="' + s.startTimeMinute + '" min="0" max="59" required></div>';
    html += '</div>';
    html += '<div class="field"><label>Duration (minutes)</label><input type="number" name="durationMinutes" value="' + s.durationMinutes + '" min="1" required></div>';
    return html;
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  <% } %>
</script>
</body>
</html>

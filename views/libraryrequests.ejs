<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('libraryrequests.title') %> — BCookieSubs</title>
  <%- include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast">
        <span class="toast-msg"><%= msg %></span>
        <button type="button" class="toast-close" aria-label="Close" data-toast-close>✕</button>
      </div>
    <% } %>

    <div class="page-header">
      <h1><%= __('libraryrequests.title') %></h1>
    </div>

    <div class="lrx-filter-bar">
      <div class="field lrx-search-field">
        <input type="search" id="lr-search" placeholder="<%= __('libraryrequests.searchPlaceholder') %>">
      </div>
      <div class="field lrx-genre-field">
        <select id="lr-genre-filter">
          <option value=""><%= __('libraryrequests.allGenres') %></option>
          <% allGenres.forEach(function(g) { %>
            <option value="<%= g %>"><%= g %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="tabs lrx-tabs">
      <button type="button" id="lr-tab-btn-movie" class="tab-btn active" onclick="lrSwitchTab('movie')">
        <%= __('libraryrequests.movies') %><% if (movieGroups.length > 0) { %> <span class="badge badge-neutral lrx-badge-sm"><%= movieGroups.length %></span><% } %>
      </button>
      <button type="button" id="lr-tab-btn-series" class="tab-btn" onclick="lrSwitchTab('series')">
        <%= __('libraryrequests.series') %><% if (seriesGroups.length > 0) { %> <span class="badge badge-neutral lrx-badge-sm"><%= seriesGroups.length %></span><% } %>
      </button>
    </div>

    <div id="lr-tab-movie">
      <% if (movieGroups.length === 0) { %>
        <div class="card">
          <p class="empty-state"><%= __('libraryrequests.noMovies') %></p>
        </div>
      <% } else { %>
        <div class="lr-grid">
          <% movieGroups.forEach(function(group) { %>
            <% var searchText = ((group.title || '') + ' ' + group.items.map(function(i){ return i.fileName || ''; }).join(' ')).toLowerCase(); %>
            <div class="lr-card" data-group-key="<%= group.key %>"
                 data-search="<%= searchText %>"
                 data-genre="<%= (group.genres || '').toLowerCase() %>">
              <div class="lr-card-poster">
                <% if (showPosters && group.posterPath) { %>
                  <img class="lr-lazy" data-src="/media-photos/<%= group.posterPath %>" alt="<%= group.title %>" loading="lazy" decoding="async">
                <% } else { %>
                  <div class="lr-card-placeholder"><i class="fa-solid fa-film"></i></div>
                <% } %>
              </div>
              <div class="lr-card-body">
                <div>
                  <div class="lr-card-title" title="<%= group.title %>"><%= group.title %></div>
                  <div class="lr-card-meta">
                    <% if (group.year) { %><span>(<%= group.year %>) · </span><% } %>
                    <span class="lr-card-genres"><%= group.genres || '' %></span>
                  </div>
                </div>
                <%
                  var _movieTrans = group.items.filter(function(i){ return !i.subtitleId && !i.whisperStatus })
                  var _movieSrt = _movieTrans.filter(function(i){ return i.hasSrt })
                  var _movieWhisper = _movieTrans.filter(function(i){ return i.isVideo })[0]
                  var _movieMissing = group.items.filter(function(i){ return i.subtitleId && i.missingTargetLangIds.length > 0 })
                  var _movieBadges = group.items.filter(function(i){ return !i.subtitleId && i.whisperStatus })
                %>
                <% _movieMissing.forEach(function(it) { %>
                  <div class="lr-missing-langs">
                    <% it.missingTargetLangIds.forEach(function(langId) { %>
                      <% var lang = langById[langId] %>
                      <% if (lang) { %>
                        <button type="button" class="btn btn-secondary lr-add-missing-lang-btn"
                          data-item-id="<%= it.itemId %>"
                          data-lang-id="<%= langId %>"
                          title="Add <%= lang.name %> to existing subtitle"><% if (lang.flagCode) { %><span class="fi fi-<%= lang.flagCode %>"></span> <% } %><%= lang.iso639 %></button>
                      <% } %>
                    <% }) %>
                  </div>
                <% }) %>
                <% _movieBadges.forEach(function(it) { %>
                  <span class="badge <%= it.whisperStatus === 'transcription_failed' ? 'badge-error' : 'badge-processing' %>"><%= __('libraryrequests.whisperStatus.' + it.whisperStatus) || it.whisperStatus %></span>
                <% }) %>
                <% if (_movieTrans.length > 0) { %>
                  <div class="lr-card-actions-col">
                    <% if (_movieWhisper) { %>
                      <button type="button" class="btn btn-secondary lr-create-subtitle-btn"
                        data-item-id="<%= _movieWhisper.itemId %>"><%= __('libraryrequests.createSubtitle') %></button>
                    <% } %>
                    <% if (_movieSrt.length > 0) { %>
                      <button type="button" class="btn btn-primary lr-translate-group-btn"
                        data-items="<%= JSON.stringify(_movieSrt.map(function(i){ return { id:i.itemId, name:i.fileName, isVideo:i.isVideo } })) %>"><%= __('libraryrequests.translate') %></button>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div id="lr-tab-series" style="display:none">
      <% if (seriesGroups.length === 0) { %>
        <div class="card">
          <p class="empty-state"><%= __('libraryrequests.noSeries') %></p>
        </div>
      <% } else { %>
        <div class="lr-grid">
          <% seriesGroups.forEach(function(group) { %>
            <% var searchText = ((group.title || '') + ' ' + group.items.map(function(i){ return i.fileName || ''; }).join(' ')).toLowerCase(); %>
            <%
              var _sm = {}
              group.items.forEach(function(it) {
                var sk = (it.season !== null && it.season !== undefined) ? String(it.season) : '__'
                if (!_sm[sk]) _sm[sk] = []
                _sm[sk].push(it)
              })
              var _skeys = Object.keys(_sm).sort(function(a,b) {
                if (a === '__') return 1; if (b === '__') return -1
                return parseInt(a) - parseInt(b)
              })
            %>
            <div class="lr-card" data-group-key="<%= group.key %>"
                 data-search="<%= searchText %>"
                 data-genre="<%= (group.genres || '').toLowerCase() %>">
              <div class="lr-card-poster">
                <% if (showPosters && group.posterPath) { %>
                  <img class="lr-lazy" data-src="/media-photos/<%= group.posterPath %>" alt="<%= group.title %>" loading="lazy" decoding="async">
                <% } else { %>
                  <div class="lr-card-placeholder"><i class="fa-solid fa-tv"></i></div>
                <% } %>
              </div>
              <div class="lr-card-body">
                <div class="lr-card-title" title="<%= group.title %>"><%= group.title %></div>
                <div class="lr-card-meta">
                  <% if (group.year) { %><span>(<%= group.year %>) · </span><% } %>
                  <span class="lr-card-genres"><%= group.genres || '' %></span>
                </div>
                <div class="lr-season-list">
                  <%# Panel A — season overview (default visible) %>
                  <div class="lr-seasons-overview">
                    <% _skeys.forEach(function(sk) { %>
                      <% var _si = _sm[sk] %>
                      <% var _slabel = sk === '__' ? __('libraryrequests.unknownSeason') : __('libraryrequests.season') + parseInt(sk) %>
                      <div class="lr-season-row" data-season-key="<%= sk %>">
                        <span class="lr-season-arrow">&#9658;</span>
                        <span class="lr-season-label"><%= _slabel %></span>
                        <span class="badge badge-neutral lrx-badge-sm"><%= _si.length %> <%= __('libraryrequests.episodeCount') %><%= _si.length !== 1 ? 's' : '' %></span>
                        <button type="button" class="btn btn-primary lr-translate-season-btn lrx-season-translate-btn"
                          data-library-path-id="<%= group.items[0].libraryPathId %>"
                          data-season="<%= sk %>"
                          onclick="event.stopPropagation(); lrTranslateSeason(this)"><%= __('libraryrequests.translateSeason') %></button>
                      </div>
                    <% }) %>
                  </div>
                  <%# Panel B — per-season episode view (hidden until season clicked) %>
                  <% _skeys.forEach(function(sk) { %>
                    <% var _si = _sm[sk] %>
                    <% var _slabel = sk === '__' ? 'Unknown Season' : 'Season ' + parseInt(sk) %>
                    <div class="lr-season-panel" data-season-key="<%= sk %>" style="display:none">
                      <div class="lr-season-back" data-season-key="<%= sk %>">
                        <span class="lr-season-arrow lrx-arrow-accent">&#9660;</span>
                        <span class="lr-season-label"><%= _slabel %></span>
                        <span class="badge badge-neutral lrx-badge-sm"><%= _si.length %> <%= __('libraryrequests.episodeCount') %><%= _si.length !== 1 ? 's' : '' %></span>
                      </div>
                      <div class="lr-season-items">
                        <% _si.forEach(function(it) { %>
                          <div class="lr-card-item lr-episode-row"
                               data-item-id="<%= it.itemId %>"
                               data-is-video="<%= it.isVideo ? '1' : '0' %>"
                               data-filename="<%= it.fileName %>">
                            <% if (it.season !== null && it.episode !== null) { %>
                              <span class="badge badge-neutral lr-episode-badge">S<%= String(it.season).padStart(2,'0') %>E<%= String(it.episode).padStart(2,'0') %></span>
                            <% } else { %>
                              <span class="badge badge-neutral lr-episode-badge"><%= it.fileName %></span>
                            <% } %>
                            <% if (it.subtitleId && it.missingTargetLangIds.length > 0) { %>
                              <div class="lr-missing-langs">
                                <% it.missingTargetLangIds.forEach(function(langId) { %>
                                  <% var lang = langById[langId] %>
                                  <% if (lang) { %>
                                    <button type="button" class="btn btn-secondary lr-add-missing-lang-btn"
                                      data-item-id="<%= it.itemId %>"
                                      data-lang-id="<%= langId %>"
                                      title="Add <%= lang.name %> to existing subtitle"><% if (lang.flagCode) { %><span class="fi fi-<%= lang.flagCode %>"></span> <% } %><%= lang.iso639 %></button>
                                  <% } %>
                                <% }) %>
                              </div>
                            <% } else if (!it.subtitleId) { %>
                              <span class="lr-episode-sources"></span>
                              <span class="lr-whisper-row lr-card-actions">
                                <% if (it.whisperStatus) { %>
                                  <span class="badge <%= it.whisperStatus === 'transcription_failed' ? 'badge-error' : 'badge-processing' %>"><%= __('libraryrequests.whisperStatus.' + it.whisperStatus) || it.whisperStatus %></span>
                                <% } else { %>
                                  <% if (it.hasSrt) { %>
                                    <button type="button" class="btn btn-primary lr-translate-btn"
                                      data-item-id="<%= it.itemId %>"><%= __('libraryrequests.translate') %></button>
                                  <% } %>
                                  <% if (it.isVideo) { %>
                                    <button type="button" class="btn btn-secondary lr-create-subtitle-btn"
                                      data-item-id="<%= it.itemId %>"><%= __('libraryrequests.createSubtitle') %></button>
                                  <% } %>
                                <% } %>
                              </span>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%# ── Subtitle source selection dialog ──────────────────────────────────── %>
<div class="modal-overlay" id="subtitle-source-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal lrx-source-modal">
    <div class="modal-header">
      <h2 id="subtitle-source-title"><%= __('libraryrequests.selectSource') %></h2>
      <button class="btn btn-icon" onclick="closeModal('subtitle-source-modal')">✕</button>
    </div>
    <div class="modal-body" id="subtitle-source-body">
      <p class="text-dim lrx-source-hint"><%= __('libraryrequests.chooseSubtitleSource') %></p>
      <div id="subtitle-source-list" class="lrx-source-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('subtitle-source-modal')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<%# ── Translate-season dialog (per-episode track picker) ──────────────────── %>
<div class="modal-overlay" id="season-translate-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2><%= __('libraryrequests.translateSeason') %></h2>
      <button class="btn btn-icon" onclick="closeModal('season-translate-modal')">✕</button>
    </div>
    <div class="modal-body">
      <p class="text-dim lrx-source-hint"><%= __('libraryrequests.seasonPickTracks') %></p>
      <div id="season-translate-list" class="season-tr-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('season-translate-modal')"><%= __('common.cancel') %></button>
      <button type="button" class="btn btn-primary" id="season-translate-confirm"><%= __('libraryrequests.translate') %></button>
    </div>
  </div>
</div>

<script src="/app.js"></script>
<script>

  function lrSwitchTab(tab) {
    document.getElementById('lr-tab-movie').style.display = tab === 'movie' ? '' : 'none'
    document.getElementById('lr-tab-series').style.display = tab === 'series' ? '' : 'none'
    document.getElementById('lr-tab-btn-movie').classList.toggle('active', tab === 'movie')
    document.getElementById('lr-tab-btn-series').classList.toggle('active', tab === 'series')
  }


  document.addEventListener('click', function(e) {
    var row = e.target.closest('.lr-season-row')
    if (row) {
      var list = row.closest('.lr-season-list')
      var sk = row.dataset.seasonKey
      list.querySelector('.lr-seasons-overview').style.display = 'none'
      list.querySelectorAll('.lr-season-panel').forEach(function(p) { p.style.display = 'none' })
      var panel = list.querySelector('.lr-season-panel[data-season-key="' + sk + '"]')
      if (panel) { panel.style.display = ''; lrLoadEpisodeSources(panel) }
      return
    }
    var back = e.target.closest('.lr-season-back')
    if (back) {
      var list = back.closest('.lr-season-list')
      list.querySelectorAll('.lr-season-panel').forEach(function(p) { p.style.display = 'none' })
      list.querySelector('.lr-seasons-overview').style.display = ''
    }
  })


  var _lrSearchTimer = null

  function lrApplyFilters() {
    var q = (document.getElementById('lr-search').value || '').trim().toLowerCase()
    var genreEl = document.getElementById('lr-genre-filter')
    var genre = genreEl ? genreEl.value.toLowerCase() : ''
    var activeTab = document.getElementById('lr-tab-btn-movie').classList.contains('active') ? 'movie' : 'series'
    var container = document.getElementById('lr-tab-' + activeTab)
    if (!container) return
    container.querySelectorAll('.lr-card').forEach(function(el) {
      var text = el.getAttribute('data-search') || ''
      var elGenre = el.getAttribute('data-genre') || ''
      var matchQ = !q || text.includes(q)
      var matchGenre = !genre || elGenre.includes(genre)
      el.style.display = (matchQ && matchGenre) ? '' : 'none'
    })
  }

  var lrSearchEl = document.getElementById('lr-search')
  if (lrSearchEl) {
    lrSearchEl.addEventListener('input', function() {
      clearTimeout(_lrSearchTimer)
      _lrSearchTimer = setTimeout(lrApplyFilters, 300)
    })
  }

  var lrGenreEl = document.getElementById('lr-genre-filter')
  if (lrGenreEl) {
    lrGenreEl.addEventListener('change', lrApplyFilters)
  }

  function showToast(message, type) {
    var t = document.createElement('div')
    t.className = 'toast toast-' + (type || 'success')
    t.innerHTML = '<span class="toast-msg"></span><button type="button" class="toast-close" aria-label="Close">✕</button>'
    t.querySelector('.toast-msg').textContent = message
    document.body.appendChild(t)
    t.querySelector('.toast-close').addEventListener('click', function() { t.remove() })
    setTimeout(function() { if (t.parentNode) t.remove() }, 4000)
  }

  function translateItem(itemId, sourceChoice) {
    var url = '/library-paths/item/' + itemId + '/translate'
    var body = ''
    if (sourceChoice) {
      body = 'sourceType=' + encodeURIComponent(sourceChoice.type || '') +
             '&sourcePath=' + encodeURIComponent(sourceChoice.path || '') +
             '&sourceLanguage=' + encodeURIComponent(sourceChoice.language || '') +
             '&sourceCodec=' + encodeURIComponent(sourceChoice.codec || '')
    }
    return fetch(url + '?json=1', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body
    }).then(function(r) {
      if (redirectIfUnauthorized(r)) return null
      return r.json()
    })
  }

  // ── Per-episode subtitle tracks (season view) ─────────────────────────────
  // When a season opens we check each episode for available subtitle tracks so
  // that episodes with none only offer "Create subtitle" (Whisper). Track
  // *selection* happens in a popup — per-episode (Translate button) or for the
  // whole season (Translate-season dialog).
  function lrLoadEpisodeSources(panel) {
    var rows = Array.prototype.slice.call(panel.querySelectorAll('.lr-episode-row'))
    return Promise.all(rows.map(function(row) {
      if (row._lrSourcesLoaded) return Promise.resolve()
      var translateBtn = row.querySelector('.lr-translate-btn')
      if (!translateBtn) { row._lrSourcesLoaded = true; return Promise.resolve() }
      var itemId = row.dataset.itemId
      return fetch('/library-requests/item/' + itemId + '/subtitle-sources')
        .then(function(r) { return r.json() })
        .then(function(data) {
          var sources = (data && data.success && data.sources) ? data.sources : []
          sources.forEach(function(s) { s.language = s.language || lrGuessLangFromName(s.filename || s.label || row.dataset.filename || '') })
          row._lrSources = sources
          row._lrSourcesLoaded = true
          // No embedded/companion track — translation isn't possible, only Whisper.
          if (sources.length === 0) { var b = row.querySelector('.lr-translate-btn'); if (b) b.remove() }
        })
        .catch(function() { row._lrSourcesLoaded = true })
    }))
  }

  function lrEpBadge(row) {
    var b = row.querySelector('.lr-episode-badge')
    return b ? (b.textContent || '').trim() : (row.dataset.filename || '')
  }

  // Translate a whole season: open a dialog with a per-episode track picker.
  var _seasonEps = []
  function lrTranslateSeason(seasonBtn) {
    var sk = seasonBtn.dataset.season
    var list = seasonBtn.closest('.lr-season-list')
    var panel = list && list.querySelector('.lr-season-panel[data-season-key="' + sk + '"]')
    if (!panel) return
    // Only episodes that still need translation (have Translate/Create actions,
    // not ones already translated showing add-language chips).
    var rows = Array.prototype.slice.call(panel.querySelectorAll('.lr-episode-row'))
      .filter(function(r) { return !r.querySelector('.lr-add-missing-lang-btn') && (r.querySelector('.lr-translate-btn') || r.querySelector('.lr-create-subtitle-btn')) })
    document.getElementById('season-translate-list').innerHTML = '<p class="text-dim">Loading episodes…</p>'
    openModal('season-translate-modal')
    Promise.all(rows.map(function(row) {
      var itemId = row.dataset.itemId
      var build = function(srcs) {
        srcs.forEach(function(s) { s.language = s.language || lrGuessLangFromName(s.filename || s.label || row.dataset.filename || '') })
        return { itemId: itemId, fileName: row.dataset.filename || '', badge: lrEpBadge(row), sources: srcs }
      }
      if (row._lrSourcesLoaded) return Promise.resolve(build(row._lrSources || []))
      return fetch('/library-requests/item/' + itemId + '/subtitle-sources')
        .then(function(r) { return r.json() })
        .then(function(data) { return build((data && data.success && data.sources) ? data.sources : []) })
        .catch(function() { return build([]) })
    })).then(renderSeasonTranslateList)
  }

  function renderSeasonTranslateList(eps) {
    _seasonEps = eps
    var container = document.getElementById('season-translate-list')
    container.innerHTML = ''
    if (eps.length === 0) { container.innerHTML = '<p class="text-dim">No episodes to translate.</p>'; return }
    eps.forEach(function(ep) {
      var rowEl = document.createElement('div')
      rowEl.className = 'season-tr-row'
      var label = document.createElement('span')
      label.className = 'badge badge-neutral season-tr-ep'
      label.textContent = ep.badge || ep.fileName
      rowEl.appendChild(label)
      if (ep.sources.length === 0) {
        var note = document.createElement('span')
        note.className = 'text-dim season-tr-note'
        note.textContent = '<%= __('libraryrequests.noTracksWhisper') %>'
        rowEl.appendChild(note)
        ep._sel = null
      } else {
        var sel = document.createElement('select')
        sel.className = 'season-tr-select'
        ep.sources.forEach(function(s, i) {
          var opt = document.createElement('option')
          opt.value = String(i)
          opt.textContent = (s.type === 'embedded' ? 'Embedded' : 'External') + ' · ' + ((s.language || '').toUpperCase() || 'unknown') + (s.codec ? (' · ' + s.codec) : '')
          sel.appendChild(opt)
        })
        rowEl.appendChild(sel)
        ep._sel = sel
      }
      container.appendChild(rowEl)
    })
  }

  ;(function() {
    var confirmBtn = document.getElementById('season-translate-confirm')
    if (!confirmBtn) return
    confirmBtn.addEventListener('click', function() {
      var jobs = _seasonEps.filter(function(ep) { return ep.sources.length > 0 && ep._sel })
      if (jobs.length === 0) { showToast('No subtitle tracks to translate', 'error'); return }
      confirmBtn.disabled = true
      var queued = 0, failed = 0
      var chain = Promise.resolve()
      jobs.forEach(function(ep) {
        chain = chain.then(function() {
          var s = ep.sources[parseInt(ep._sel.value, 10)] || ep.sources[0]
          var choice = { type: s.type, path: s.path, language: s.language || '', codec: s.codec }
          return translateItem(ep.itemId, choice)
            .then(function(resp) { if (resp && resp.success) queued++; else failed++ })
            .catch(function() { failed++ })
        })
      })
      chain.then(function() {
        confirmBtn.disabled = false
        closeModal('season-translate-modal')
        showToast('Queued ' + queued + ' episode(s)' + (failed ? ', ' + failed + ' failed' : ''), (failed && !queued) ? 'error' : 'success')
        if (queued) setTimeout(function() { location.reload() }, 900)
      })
    })
  })()

  function handleTranslateClick(btn) {
    var itemId = btn.dataset.itemId
    var card = btn.closest('.lr-card')
    var guessedLang = lrGuessSourceLang(btn)
    var defaultChoice = guessedLang ? { language: guessedLang } : null
    // In a season panel the episode's tracks may already be loaded — reuse them.
    var epRow = btn.closest('.lr-episode-row')
    if (epRow && epRow._lrSourcesLoaded) {
      var loaded = epRow._lrSources || []
      if (loaded.length === 0) { translateItem(itemId, defaultChoice).then(function(resp) { onTranslateResponse(btn, resp) }); return }
      if (loaded.length === 1) {
        var one = loaded[0]; if (!one.language && guessedLang) one.language = guessedLang
        translateItem(itemId, one).then(function(resp) { onTranslateResponse(btn, resp) }); return
      }
      openSourceDialog(itemId, loaded, btn, guessedLang); return
    }
    fetch('/library-requests/item/' + itemId + '/subtitle-sources')
      .then(function(r) { return r.json() })
      .then(function(data) {
        if (!data || !data.success) {
          // No source listing — queue using the language guessed from the filename
          translateItem(itemId, defaultChoice).then(function(resp) { onTranslateResponse(btn, resp) })
          return
        }
        var sources = data.sources || []
        if (sources.length === 0) {
          translateItem(itemId, defaultChoice).then(function(resp) { onTranslateResponse(btn, resp) })
          return
        }
        if (sources.length === 1) {
          // Use the only one (fill in the guessed language if the track has none)
          var only = sources[0]
          if (!only.language && guessedLang) only.language = guessedLang
          translateItem(itemId, only).then(function(resp) { onTranslateResponse(btn, resp) })
          return
        }
        // Multiple sources — show dialog
        openSourceDialog(itemId, sources, btn, guessedLang)
      })
      .catch(function() {
        translateItem(itemId, defaultChoice).then(function(resp) { onTranslateResponse(btn, resp) })
      })
  }

  // Guess the source language from a filename's trailing code, e.g. "...da.srt" → "da".
  function lrGuessSourceLang(btn) {
    var item = btn.closest('.lr-card-item')
    var fnEl = item && item.querySelector('.lr-card-item-filename')
    var name = fnEl ? (fnEl.getAttribute('title') || fnEl.textContent || '') : ''
    return lrGuessLangFromName(name)
  }

  function lrGuessLangFromName(name) {
    if (!name) return ''
    var base = String(name).replace(/\.(srt|ass|ssa|vtt|sub)$/i, '')
    var m = base.match(/\.([a-z]{2,3})$/i)
    return m ? m[1].toLowerCase() : ''
  }

  function openSourceDialog(itemId, sources, btn, guessedLang) {
    var list = document.getElementById('subtitle-source-list')
    list.innerHTML = ''
    sources.forEach(function(s) {
      var srcLang = s.language || lrGuessLangFromName(s.filename || s.label) || guessedLang || ''
      var row = document.createElement('button')
      row.type = 'button'
      row.className = 'btn btn-secondary lr-source-pick'
      var typeLabel = s.type === 'embedded' ? 'Embedded' : 'External'
      var langLabel = srcLang ? srcLang.toUpperCase() : 'unknown'
      var codecLine = s.codec ? ' · ' + s.codec : ''
      // Detail line: show the filename once (external/standalone). For embedded
      // tracks there is no file, so fall back to the descriptive label only when
      // it isn't just a duplicate of the filename.
      var detail = s.filename || (s.label && s.label !== s.filename ? s.label : '')
      row.innerHTML = '<strong>' + lrEsc(typeLabel + ' · ' + langLabel + codecLine) + '</strong>' +
        (detail ? '<span class="text-dim lr-source-detail">' + lrEsc(detail) + '</span>' : '')
      row.addEventListener('click', function() {
        closeModal('subtitle-source-modal')
        var choice = { type: s.type, path: s.path, language: srcLang, codec: s.codec }
        translateItem(itemId, choice).then(function(resp) { onTranslateResponse(btn, resp) })
      })
      list.appendChild(row)
    })
    openModal('subtitle-source-modal')
  }

  function lrEsc(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
  }

  // Movie "Translate": one button per movie. Aggregates the subtitle sources
  // across all of the movie's files/tracks and lets the user pick one in the
  // popup (or queues directly when there is exactly one option).
  function lrTranslateMovie(btn) {
    var items
    try { items = JSON.parse(btn.dataset.items || '[]') } catch (e) { items = [] }
    if (items.length === 0) return
    btn.disabled = true
    Promise.all(items.map(function(it) {
      return fetch('/library-requests/item/' + it.id + '/subtitle-sources')
        .then(function(r) { return r.json() })
        .then(function(data) {
          var srcs = (data && data.success && data.sources) ? data.sources : []
          if (srcs.length === 0) {
            return [{ itemId: it.id, fileName: it.name, source: null, lang: lrGuessLangFromName(it.name) }]
          }
          return srcs.map(function(s) {
            return { itemId: it.id, fileName: it.name, source: s, lang: s.language || lrGuessLangFromName(s.filename || s.label || it.name) }
          })
        })
        .catch(function() { return [{ itemId: it.id, fileName: it.name, source: null, lang: lrGuessLangFromName(it.name) }] })
    })).then(function(lists) {
      btn.disabled = false
      var opts = [].concat.apply([], lists)
      if (opts.length === 0) return
      if (opts.length === 1) { lrDoMovieTranslate(opts[0], btn); return }
      lrShowMovieSourcePopup(opts, btn, items.length > 1)
    }).catch(function() { btn.disabled = false; showToast('Request failed', 'error') })
  }

  function lrDoMovieTranslate(opt, btn) {
    var choice = opt.source
      ? { type: opt.source.type, path: opt.source.path, language: opt.source.language || opt.lang || '', codec: opt.source.codec }
      : (opt.lang ? { language: opt.lang } : null)
    translateItem(opt.itemId, choice).then(function(resp) {
      if (!resp) return
      showToast(resp.msg || (resp.success ? 'Queued' : 'Failed'), resp.success ? 'success' : 'error')
      if (resp.success) setTimeout(function() { location.reload() }, 800)
    })
  }

  function lrShowMovieSourcePopup(opts, btn, showFile) {
    var list = document.getElementById('subtitle-source-list')
    list.innerHTML = ''
    opts.forEach(function(opt) {
      var s = opt.source
      var row = document.createElement('button')
      row.type = 'button'
      row.className = 'btn btn-secondary lr-source-pick'
      var typeLabel = s ? (s.type === 'embedded' ? 'Embedded' : 'External') : 'Subtitle file'
      var langLabel = (opt.lang || '').toUpperCase() || 'unknown'
      var codecLine = s && s.codec ? ' · ' + s.codec : ''
      var detail = showFile ? opt.fileName : ((s && s.filename) || '')
      row.innerHTML = '<strong>' + lrEsc(typeLabel + ' · ' + langLabel + codecLine) + '</strong>' +
        (detail ? '<span class="text-dim lr-source-detail">' + lrEsc(detail) + '</span>' : '')
      row.addEventListener('click', function() {
        closeModal('subtitle-source-modal')
        lrDoMovieTranslate(opt, btn)
      })
      list.appendChild(row)
    })
    openModal('subtitle-source-modal')
  }

  function onTranslateResponse(btn, data) {
    if (!data) return
    if (data.success) {
      var itemRow = btn.closest('.lr-card-item')
      if (itemRow) itemRow.style.display = 'none'

      var seasonPanel = btn.closest('.lr-season-panel')
      if (seasonPanel) {
        var panelItems = seasonPanel.querySelectorAll('.lr-card-item')
        var panelHasVisible = false
        for (var si = 0; si < panelItems.length; si++) {
          if (panelItems[si].style.display !== 'none') { panelHasVisible = true; break }
        }
        if (!panelHasVisible) {
          var list = seasonPanel.closest('.lr-season-list')
          var sk = seasonPanel.dataset.seasonKey
          var overviewRow = list && list.querySelector('.lr-season-row[data-season-key="' + sk + '"]')
          if (overviewRow) overviewRow.style.display = 'none'
          seasonPanel.style.display = 'none'
          var overview = list && list.querySelector('.lr-seasons-overview')
          if (overview) overview.style.display = ''
        }
      }
      var card = btn.closest('.lr-card')
      if (card) {
        var visibleItems = card.querySelectorAll('.lr-card-item')
        var hasVisible = false
        for (var i = 0; i < visibleItems.length; i++) {
          if (visibleItems[i].style.display !== 'none') { hasVisible = true; break }
        }
        if (!hasVisible) card.style.display = 'none'
      }
      showToast(data.msg || 'Queued', 'success')
    } else {
      showToast(data.msg || 'Failed', 'error')
    }
  }

  document.addEventListener('click', function(e) {
    var groupBtn = e.target.closest('.lr-translate-group-btn')
    if (groupBtn) {
      lrTranslateMovie(groupBtn)
      return
    }

    var btn = e.target.closest('.lr-translate-btn')
    if (btn) {
      handleTranslateClick(btn)
    }
    // Note: the Translate-season button calls lrTranslateSeason() via its own
    // onclick (it stops propagation so the season row doesn't toggle open).

    var createSubtitleBtn = e.target.closest('.lr-create-subtitle-btn')
    if (createSubtitleBtn) {
      var itemId = createSubtitleBtn.dataset.itemId
      createSubtitleBtn.disabled = true
      createSubtitleBtn.textContent = '<%= __('libraryrequests.creatingSubtitle') %>'
      fetch('/library-requests/item/' + itemId + '/create-whisper-subtitle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
      })
        .then(function(r) { if (redirectIfUnauthorized(r)) return null; return r.json() })
        .then(function(data) {
          if (!data) return
          showToast(data.msg || (data.success ? 'Created' : 'Failed'), data.success ? 'success' : 'error')
          if (data.success) {
            createSubtitleBtn.closest('.lr-whisper-row').innerHTML =
              '<span class="badge badge-processing"><%= __('libraryrequests.whisperStatus.queued_for_transcription') %></span>'
          } else {
            createSubtitleBtn.disabled = false
            createSubtitleBtn.textContent = '<%= __('libraryrequests.createSubtitle') %>'
          }
        })
        .catch(function() {
          createSubtitleBtn.disabled = false
          createSubtitleBtn.textContent = '<%= __('libraryrequests.createSubtitle') %>'
          showToast('Request failed', 'error')
        })
    }

    var missingBtn = e.target.closest('.lr-add-missing-lang-btn')
    if (missingBtn) {
      var itemId = missingBtn.dataset.itemId
      var langId = missingBtn.dataset.langId
      var body = 'targetLangIds=' + encodeURIComponent(langId)
      fetch('/library-requests/item/' + itemId + '/add-missing-lang?json=1', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body
      })
        .then(function(r) { if (redirectIfUnauthorized(r)) return null; return r.json() })
        .then(function(data) {
          if (!data) return
          if (data.success) {
            missingBtn.style.display = 'none'
            showToast(data.msg || 'Added', 'success')
          } else {
            showToast(data.msg || 'Failed', 'error')
          }
        })
        .catch(function() { showToast('Request failed', 'error') })
    }
  })

  // Lazy load images using IntersectionObserver as a fallback
  ;(function() {
    var lazyImgs = document.querySelectorAll('img.lr-lazy')
    if (!('IntersectionObserver' in window)) {
      lazyImgs.forEach(function(img) { if (img.dataset.src) img.src = img.dataset.src })
      return
    }
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var img = entry.target
          if (img.dataset.src) {
            img.src = img.dataset.src
            img.removeAttribute('data-src')
          }
          obs.unobserve(img)
        }
      })
    }, { rootMargin: '200px' })
    lazyImgs.forEach(function(img) { obs.observe(img) })
  })()

  // Close-toast button (for any server-rendered toast)
  document.addEventListener('click', function(e) {
    if (e.target.matches('[data-toast-close]') || e.target.closest('[data-toast-close]')) {
      var t = e.target.closest('.toast')
      if (t) t.remove()
    }
  })
</script>
</body>
</html>

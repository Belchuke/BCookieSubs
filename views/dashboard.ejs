<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('dashboard.title') %> — BCookieSubs</title>
   <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast === 'error' && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('dashboard.title') %></h1>
      <div class="dsh-row-center">
        <% if (can('canManageWorker')) { %>
          <button id="worker-stop-btn" class="btn btn-warning" onclick="workerControl('pause')" style="<%= workerPaused ? 'display:none' : 'display:inline-flex' %>"><%= __('dashboard.stopWorker') %></button>
          <button id="worker-start-btn" class="btn btn-secondary" onclick="workerControl('resume')" style="<%= workerPaused ? 'display:inline-flex' : 'display:none' %>"><%= __('dashboard.startWorker') %></button>
        <% } %>
        <% if (can('canCancelTranslationJob') || can('canDeleteTranslation')) { %>
          <button id="dsh-select-btn" class="btn btn-secondary" onclick="toggleSelectMode()"><%= __('dashboard.select') %></button>
        <% } %>
        <% if (can('canAddSubtitleToTranslateDashboard')) { %>
          <button class="btn btn-primary" onclick="openModal('upload-modal')"><%= __('dashboard.addSubtitle') %></button>
        <% } %>
      </div>
    </div>

    <div class="card" id="queue-card">
      <div class="card-header"><h2><%= __('dashboard.translationQueue') %></h2></div>
      <div id="queue-list">
        <p class="empty-state" id="queue-empty"><%= __('common.loading') %></p>
      </div>
    </div>

    <div class="card dsh-mt-15" id="ocr-queue-card" style="display:none">
      <div class="card-header">
        <h2><%= __('dashboard.ocrQueue') %></h2>
        <div class="dsh-row-center">
          <% if (can('canManageWorker')) { %>
            <button id="ocr-worker-stop-btn" class="btn btn-warning" onclick="ocrWorkerControl('pause')" style="<%= ocrWorkerPaused ? 'display:none' : 'display:inline-flex' %>"><%= __('dashboard.stopOcrWorker') %></button>
            <button id="ocr-worker-start-btn" class="btn btn-secondary" onclick="ocrWorkerControl('resume')" style="<%= ocrWorkerPaused ? 'display:inline-flex' : 'display:none' %>"><%= __('dashboard.startOcrWorker') %></button>
          <% } %>
        </div>
      </div>
      <div id="ocr-queue-list">
        <p class="empty-state" id="ocr-queue-empty"><%= __('common.loading') %></p>
      </div>
    </div>

    <% if (locals.whisperSeparate) { %>
    <div class="card dsh-mt-15" id="whisper-queue-card" style="display:none">
      <div class="card-header">
        <h2><%= __('dashboard.whisperQueue') %></h2>
        <div class="dsh-row-center">
          <% if (can('canManageWorker')) { %>
            <button id="whisper-worker-stop-btn" class="btn btn-warning" onclick="whisperWorkerControl('pause')" style="<%= whisperWorkerPaused ? 'display:none' : 'display:inline-flex' %>"><%= __('dashboard.stopWhisperWorker') %></button>
            <button id="whisper-worker-start-btn" class="btn btn-secondary" onclick="whisperWorkerControl('resume')" style="<%= whisperWorkerPaused ? 'display:inline-flex' : 'display:none' %>"><%= __('dashboard.startWhisperWorker') %></button>
          <% } %>
        </div>
      </div>
      <div id="whisper-queue-list">
        <p class="empty-state" id="whisper-queue-empty"><%= __('common.loading') %></p>
      </div>
    </div>
    <% } %>

    <div class="card dsh-mt-15">
      <div class="card-header">
        <h2><%= __('dashboard.recentLogs') %></h2>
        <small class="text-dim" id="log-count">—</small>
      </div>
      <div class="log-panel" id="log-panel">
        <p class="text-dim dsh-p-5"><%= __('common.loading') %></p>
      </div>
    </div>
  </main>
</div>

<div class="modal-overlay" id="upload-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-xl">
    <div class="modal-header">
      <h2><%= __('dashboard.addSubtitleStep1') %></h2>
      <button class="btn btn-icon" onclick="closeModal('upload-modal')">✕</button>
    </div>
    <form id="upload-form-step1">
      <div class="field">
        <label><%= __('dashboard.srtFile') %></label>
        <div class="upload-zone" id="upload-zone" onclick="document.getElementById('up1-srtFile').click()">
          <input type="file" id="up1-srtFile" name="srtFile" accept=".srt,.ass,.ssa" required class="dsh-hidden">
          <div class="upload-zone-content">
            <div class="upload-text">
              <span id="click-to-upload-1" class="upload-text-main"><%= __('dashboard.clickToUpload') %></span>
              <span id="click-to-upload-2" class="upload-text-sub"><%= __('dashboard.srtOnly') %></span>
            </div>
            <div class="upload-filename" id="upload-filename"></div>
          </div>
        </div>
      </div>
      <div class="field">
        <label for="up1-sourceLangId"><%= __('dashboard.sourceLanguage') %></label>
        <select id="up1-sourceLangId" name="sourceLangId" required>
          <% var englishFound = false; languages.forEach(function(l) { %>
            <option value="<%= l.id %>" <%= !englishFound && l.iso639 === 'en' ? 'selected' : '' %>><%= l.name %></option>
            <% if (l.iso639 === 'en') englishFound = true; %>
          <% }) %>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('upload-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary" formnovalidate><%= __('common.next') %> →</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="upload-modal-step2" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-xl">
    <div class="modal-header">
      <h2><%= __('dashboard.addSubtitleStep2') %></h2>
      <button class="btn btn-icon" onclick="closeModal('upload-modal-step2')">✕</button>
    </div>
    <form id="upload-form-step2">
      <input type="hidden" id="up2-sourceLangId" name="sourceLangId" value="">
      <input type="hidden" id="up2-theMovieDbId" name="theMovieDbId" value="">
      <input type="hidden" id="up2-posterBase64" name="posterBase64" value="">
      <input type="hidden" id="up2-originalTitle" name="originalTitle" value="">
      <input type="hidden" id="up2-isAnime" name="isAnime" value="">
      <input type="hidden" id="up2-genres" name="genres" value="">
      <input type="hidden" id="up2-posterUrl" name="posterUrl" value="">

      <div id="up2-tmdb-selector" class="field" style="display:none">
        <label for="up2-tmdb-select"><%= __('dashboard.tmdbMatch') %></label>
        <select id="up2-tmdb-select"></select>
      </div>

      <div class="upload-step2-body dsh-step2-body">
        <div class="dsh-flex-1">
          <div class="field">
            <label for="up2-name"><%= __('dashboard.mediaTitle') %></label>
            <input type="text" id="up2-name" name="mediaTitle" required placeholder="e.g. The Dark Knight">
          </div>
          <div class="field-row">
            <div class="field">
              <label for="up2-type"><%= __('dashboard.type') %></label>
              <select id="up2-type" name="mediaType" onchange="toggleSeriesFields(this.value)">
                <option value="movie"><%= __('dashboard.movie') %></option>
                <option value="series"><%= __('dashboard.series') %></option>
                <option value="unknown"><%= __('dashboard.unknown') %></option>
              </select>
            </div>
            <div class="field dsh-mw-7">
              <label for="up2-year"><%= __('dashboard.year') %></label>
              <input type="number" id="up2-year" name="mediaYear" min="1900" max="2100" placeholder="2024">
            </div>
            <div class="field" id="up2-season-field" style="display:none">
              <label for="up2-season"><%= __('dashboard.season') %></label>
              <input type="number" id="up2-season" name="season" min="1"  placeholder="1">
            </div>
            <div class="field" id="up2-episode-field" style="display:none">
              <label for="up2-episode"><%= __('dashboard.episode') %></label>
              <input type="number" id="up2-episode" name="episode" min="1" placeholder="1">
            </div>
          </div>
          <div class="field">
            <label><%= __('dashboard.targetLanguages') %></label>
            <div id="up2-lang-chips" class="dsh-lang-chips"></div>
            <div class="checkbox-group dsh-mh-90" id="up2-lang-group">
              <% languages.forEach(function(l) { %>
                <% var isDefault = userConfigLangs.some(function(cl){ return cl.languageId === l.id }) %>
                <label class="checkbox-label">
                  <input type="checkbox" name="targetLangIds" value="<%= l.id %>" <%= isDefault ? 'checked' : '' %>>
                  <% if (l.flagCode) { %><span class="fi fi-<%= l.flagCode %>"></span> <% } %><%= l.name %>
                </label>
              <% }) %>
            </div>
          </div>
          <div class="field">
            <label for="up2-chunkSize"><%= __('dashboard.chunkSizeOverride') %> <span class="text-dim">(blank = default <%= config.defaultChunkSize %>)</span></label>
            <input type="number" id="up2-chunkSize" name="chunkSetting" min="1" max="200" placeholder="<%= config.defaultChunkSize %>">
          </div>
        </div>

        <div id="up2-poster-wrap" class="dsh-poster-wrap" style="display:none">
          <img id="up2-poster" src="" alt="Poster" class="dsh-poster">
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('upload-modal-step2');openModal('upload-modal')">← <%= __('common.back') %></button>
        <button type="submit" class="btn btn-primary"><%= __('dashboard.addToQueue') %></button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="inspect-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2 id="inspect-title"><%= __('dashboard.jobDetails') %></h2>
      <button class="btn btn-icon" onclick="closeModal('inspect-modal')">✕</button>
    </div>
    <div id="inspect-body" class="inspect-body"><%= __('common.loading') %></div>
  </div>
</div>

<script>
  var LANGUAGE_MAP = <%- JSON.stringify(Object.fromEntries(languages.map(function(l){ return [l.id, l] }))) %>;
  var CAN_STOP = <%- JSON.stringify(can('canCancelTranslationJob')) %>;
  var CAN_DELETE = <%- JSON.stringify(can('canDeleteTranslation')) %>;
  var SHOW_POSTERS = <%- showPosters ? 'true' : 'false' %>;
  var DELETE_NOT_CANCEL = <%- deleteNotCancel ? 'true' : 'false' %>;
  var DASHBOARD_NO_JOBS = '<%= __("dashboard.noSubtitleJobs") %>';
  var APP_STRINGS = {
    pleaseSelectSrt:      '<%= __("dashboard.pleaseSelectSrt") %>',
    pleaseSelectLang:     '<%= __("dashboard.pleaseSelectLang") %>',
    select:               '<%= __("dashboard.select") %>',
    doneSelect:           '<%= __("dashboard.doneSelect") %>',
    selected:             '<%= __("dashboard.selected") %>',
    bulkJobs:             '<%= __("dashboard.bulkJobs") %>',
    bulkActiveWillCancel: '<%= __("dashboard.bulkActiveWillCancel") %>',
    bulkActiveWillDelete: '<%= __("dashboard.bulkActiveWillDelete") %>',
    bulkCancelledWillDelete: '<%= __("dashboard.bulkCancelledWillDelete") %>',
    analyzing:            '<%= __("dashboard.analyzing") %>',
    nextBtn:              '<%= __("dashboard.nextBtn") %>',
    errorAnalyzing:       '<%= __("dashboard.errorAnalyzing") %>',
    noFileSelected:       '<%= __("dashboard.noFileSelected") %>',
    adding:               '<%= __("dashboard.adding") %>',
    addToQueue:           '<%= __("dashboard.addToQueue") %>',
    errorGeneric:         '<%= __("dashboard.errorGeneric") %>',
    progressCompleted:    '<%= __("dashboard.progressCompleted") %>',
    progressFailed:       '<%= __("dashboard.progressFailed") %>',
    progressRemaining:    '<%= __("dashboard.progressRemaining") %>',
    cancel:               '<%= __("common.cancel") %>',
    delete:               '<%= __("common.delete") %>',
    hide:                 '<%= __("common.hide") %>',
    inspect:              '<%= __("common.inspect") %>',
    reset:                '<%= __("common.reset") %>',
    moveUp:               '<%= __("common.moveUp") %>',
    moveDown:             '<%= __("common.moveDown") %>',
    dragToReorder:        '<%= __("common.dragToReorder") %>',
    loading:              '<%= __("common.loading") %>',
    actions:              '<%= __("common.actions") %>',
    statusDone:           '<%= __("dashboard.statusDone") %>',
    statusCancelled:      '<%= __("dashboard.statusCancelled") %>',
    statusProcessing:     '<%= __("dashboard.statusProcessing") %>',
    episodeSingular:      '<%= __("dashboard.episodeSingular") %>',
    episodePlural:        '<%= __("dashboard.episodePlural") %>',
    logLast:              '<%= __("dashboard.logLast") %>',
    logEntries:           '<%= __("dashboard.logEntries") %>',
    noLogEntries:         '<%= __("dashboard.noLogEntries") %>',
    inspectNum:           '<%= __("dashboard.inspectNum") %>',
    inspectStatus:        '<%= __("dashboard.inspectStatus") %>',
    inspectStartedAt:     '<%= __("dashboard.inspectStartedAt") %>',
    inspectFinishedAt:    '<%= __("dashboard.inspectFinishedAt") %>',
    inspectDuration:      '<%= __("dashboard.inspectDuration") %>',
    inspectReset:         '<%= __("dashboard.inspectReset") %>',
    noChunkData:          '<%= __("dashboard.noChunkData") %>',
    failedToLoad:         '<%= __("dashboard.failedToLoad") %>',
    retryFailed:          '<%= __("dashboard.retryFailed") %>',
    resetFailed:          '<%= __("dashboard.resetFailed") %>',
    inspectStatusQueued:     '<%= __("dashboard.inspectStatusQueued") %>',
    inspectStatusRunning:    '<%= __("dashboard.inspectStatusRunning") %>',
    inspectStatusDone:       '<%= __("dashboard.inspectStatusDone") %>',
    inspectStatusFailed:     '<%= __("dashboard.inspectStatusFailed") %>',
    inspectStatusCancelled:  '<%= __("dashboard.inspectStatusCancelled") %>',
    inspectStatusRetrying:   '<%= __("dashboard.inspectStatusRetrying") %>',
    inspectStatusWaiting:    '<%= __("dashboard.inspectStatusWaiting") %>',
    whisperStatus_queued_for_transcription: '<%= __("dashboard.whisperStatusQueuedForTranscription") %>',
    whisperStatus_transcribing:             '<%= __("dashboard.whisperStatusTranscribing") %>',
    whisperStatus_transcription_failed:     '<%= __("dashboard.whisperStatusTranscriptionFailed") %>',
    whisperStatus_transcription_completed:'<%= __("dashboard.whisperStatusTranscriptionCompleted") %>',
    whisperStatus_queued_for_translation:   '<%= __("dashboard.whisperStatusQueuedForTranslation") %>',
    whisperStatus_translating:              '<%= __("dashboard.whisperStatusTranslating") %>',
    whispering:                             '<%= __("dashboard.whispering") %>',
    ocrStatus_queued:                       '<%= __("dashboard.ocrStatusQueued") %>',
    ocrStatus_processing:                   '<%= __("dashboard.ocrStatusProcessing") %>',
    ocrStatus_failed:                       '<%= __("dashboard.ocrStatusFailed") %>'
  };

  function toggleSeriesFields(val) {
    document.getElementById("up2-season-field").style.display = val === "series" ? "" : "none"
    document.getElementById("up2-episode-field").style.display = val === "series" ? "" : "none"
  }

  function updateLangChips() {
    var el = document.getElementById("up2-lang-chips")
    if (!el) return
    var checked = Array.from(document.querySelectorAll('#up2-lang-group input[type="checkbox"]:checked'))
    if (checked.length === 0) {
      el.innerHTML = '<span style="color:var(--text-dim);font-size:.78rem"><%= __('dashboard.noneSelected') %></span>'
      return
    }
    el.innerHTML = checked.map(function(cb) {
      var lbl = cb.closest("label")
      var text = lbl ? lbl.textContent.trim() : cb.value
      return '<span class="badge badge-info" style="font-size:.73rem">' + text + "</span>"
    }).join("")
  }

  ;(function() {
    var group = document.getElementById("up2-lang-group")
    if (group) group.addEventListener("change", updateLangChips)
    updateLangChips()
  })();

  ;(function() {
    var zone = document.getElementById('upload-zone');
    var fileInput = document.getElementById('up1-srtFile');
    var fileNameEl = document.getElementById('upload-filename');
    var uploadFormStep1 = document.getElementById('click-to-upload-1')
    var uploadFormStep2 = document.getElementById('click-to-upload-2')
    if (!zone || !fileInput) return;

    function setDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      zone.classList.add('drag-over');
    }
    function clearDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      zone.classList.remove('drag-over');
    }

    ['dragenter', 'dragover'].forEach(function(evt) {
      zone.addEventListener(evt, setDragOver, false);
    });
    ['dragleave', 'drop'].forEach(function(evt) {
      zone.addEventListener(evt, clearDragOver, false);
    });

    zone.addEventListener('drop', function(e) {
      var files = e.dataTransfer.files;
      if (files.length > 0) {
        var dt = new DataTransfer();
        dt.items.add(files[0]);
        fileInput.files = dt.files;
        updateFileName(files[0].name);
      }
    }, false);

    fileInput.addEventListener('change', function() {
      if (fileInput.files.length > 0) {
        updateFileName(fileInput.files[0].name);
        uploadFormStep1.style.display = 'none';
        uploadFormStep2.style.display = 'none';
      }
    });

    function updateFileName(name) {
      if (fileNameEl) {
        fileNameEl.textContent = name;
        fileNameEl.style.display = 'block';
      }
    }
  })();
</script>

<div id="dsh-bulk-bar" class="dsh-bulk-bar" style="display:none">
  <span id="dsh-bulk-count" class="dsh-bulk-count">0 <%= __('dashboard.selected') %></span>
  <div class="dsh-row-center">
    <button id="dsh-bulk-clear-btn" class="btn btn-secondary" onclick="clearBulkSelection()"><%= __('dashboard.clearSelection') %></button>
    <button id="dsh-bulk-action-btn" class="btn btn-danger" onclick="openBulkConfirm()"><%= __('dashboard.applyCancelDelete') %></button>
  </div>
</div>

<div class="modal-overlay" id="bulk-confirm-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2 id="bulk-confirm-title"><%= __('dashboard.bulkConfirmTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('bulk-confirm-modal')">✕</button>
    </div>
    <div class="modal-body">
      <p id="bulk-confirm-summary" class="text-dim"></p>
      <ul id="bulk-confirm-list" class="bulk-confirm-list"></ul>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('bulk-confirm-modal')"><%= __('common.cancel') %></button>
      <button id="bulk-confirm-submit" class="btn btn-danger" onclick="submitBulkAction()"><%= __('dashboard.applyCancelDelete') %></button>
    </div>
  </div>
</div>

<script src="/app.js"></script>
</body>
</html>

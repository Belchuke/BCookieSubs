# BCookieSubs configuration — copy to .env (setup.sh does this for you).
# Every variable the stack reads is listed here. Anything you leave empty either
# falls back to the documented default or is generated automatically by setup.sh.

# ============================================================================
# 1. Core stack — database, ports
# ============================================================================

# PostgreSQL connection for the app (created on first `docker compose up`).
POSTGRES_USER=bcookiesubs
POSTGRES_PASSWORD=
POSTGRES_DB=bcookiesubs

# Host ports. Defaults: web 4850, postgres 4851, ollama 4852, worker gateway 4853.
WEB_PORT=4850
POSTGRES_PORT=4851
OLLAMA_PORT=4852
WORKER_GATEWAY_PORT=4853

# Address the PostgreSQL port is published on. 127.0.0.1 keeps the database
# private to the host; use 0.0.0.0 to expose it to the network.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Host port for the worker gateway under the dev overlay (docker-compose.dev.yml).
# Default: 5101. Only used with -f docker-compose.dev.yml.
#WORKER_DEV_PORT=5101

# ============================================================================
# 2. Internal secrets — auto-generated by setup.sh, keep them stable
# ============================================================================

# Shared secret between BCookieSubs.Web and the C# worker's gRPC gateway
# (config keys Orchestration__ApiKey on both services).
ORCHESTRATION_API_KEY=

# Signing key for JWTs issued to Python workers for gateway authentication
# (config key Worker__SigningKey).
WORKER_JWT_SIGNING_KEY=

# Master key for AES-256-GCM encryption of application-managed secrets in the
# database (Settings → Secrets, SFTP credentials). Changing it invalidates
# every stored secret.
SECRET_ENCRYPTION_KEY=

# Enrollment token for the first run of a Python worker. Only needed when a
# worker enrolls; afterwards the worker stores WORKER_ID + WORKER_SECRET.
# Leave empty to disable token-based enrollment.
WORKER_BOOTSTRAP_TOKEN=

# ============================================================================
# 3. Provider API keys (also editable in Settings → Secrets)
# ============================================================================

# These are synced into the database at startup. While the env var is set, the
# matching entry in Settings → Secrets is env-managed (shown, not deletable).
# Leave empty to manage the key in the UI instead.

# themoviedb.org API key — poster/episode-image lookup when poster mode is on.
THEMOVIEDB_API_KEY=

# For Ollama Cloud or external gateways that require an API key.
OLLAMA_API_KEY=

# Direct LLM providers (translation fallback / judge endpoint), optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================================
# 4. Ollama
# ============================================================================

# Base URL the app uses for Ollama requests (LLM translation + judge).
# Default when empty: http://127.0.0.1:11434. In compose deployments typically
# http://ollama:11434 (compose profile), http://host.docker.internal:11434
# (host Ollama, macOS), or your Ollama Cloud URL.
OLLAMA_BASE_URL=

# ============================================================================
# 5. Library & app defaults (read by the seeder on first run)
# ============================================================================

# Host directory that is the root of your local media library. Shown in the UI
# initially; can be changed later in Settings. Used in compose to mount the
# library into web/worker/python-worker containers.
TRANSLATION_ROOT_DIR=

# Default UI language code seeded into the database, e.g. "en", "th".
# Empty → English.
APP_DEFAULT_LANGUAGE=

# Font used when exporting Thai subtitles to ASS. Empty → "Garuda".
# THAI_ASS_FONT=

# ============================================================================
# 6. Local Python worker (compose maps these to the worker_* variables)
# ============================================================================

# Display name of the bundled Python worker container.
LOCAL_WORKER_NAME=local-python-worker

# Capabilities this worker reports: whisper, ocr, vision.
# (vision has no engine yet; harmless to declare.)
LOCAL_WORKER_CAPABILITIES=whisper,ocr

# Concurrent compute jobs this worker may run.
LOCAL_WORKER_MAX_CONCURRENCY=1

# Token the worker enrolls with on first run. Empty → uses WORKER_BOOTSTRAP_TOKEN.
LOCAL_WORKER_ENROLLMENT_TOKEN=

# ============================================================================
# 7. Standalone Python worker — for deployments outside docker compose
#    (GPU machine pointing at the C# worker gateway; setup.sh's compose
#    python-worker maps section 6 into these instead)
# ============================================================================

# Gateway URL, e.g. http://your-bcookiesubs-host:4853 (required).
#BCOKIESUBS_SERVER_URL=http://your-bcookiesubs-host:4853

# First run: enrollment token from WORKER_BOOTSTRAP_TOKEN. Later runs: the
# WORKER_ID + WORKER_SECRET the server issued (stored in WORKER_DATA_DIR).
#WORKER_ID=
#WORKER_SECRET=

# Worker display name. Default: "python-worker".
#WORKER_NAME=

# Reported capabilities: whisper, ocr, vision.
#WORKER_CAPABILITIES=whisper,ocr

# Concurrent compute jobs. Default: 1.
#WORKER_MAX_CONCURRENCY=1

# Heartbeat interval in seconds (minimum 3). Default: 10.
#WORKER_HEARTBEAT_INTERVAL=10

# Skip TLS certificate verification on https gateways (1/true/yes). For self-hosted testing only.
#WORKER_INSECURE=1

# Directory holding identity.json (worker id/secret/machine id). Default: "data".
#WORKER_DATA_DIR=

# Unique machine identifier; generated and persisted automatically when empty.
#WORKER_MACHINE_IDENTIFIER=

# Root of the faster-whisper model cache (downloaded on first use).
# Default: /models/whisper, which should be the shared /models volume mount.
#WHISPER_MODEL_ROOT=

# ============================================================================
# 8. Optional tuning & diagnostics (all have sane defaults)
# ============================================================================

# Extra attempts when the LLM judge rejects a translated chunk for format
# problems. Default: 3.
#JUDGE_FORMAT_RETRIES=3

# Staging directory on web/worker for library export/archive extracts.
# Default: /work/staging (must be under the shared /work volume in compose).
#BCOOKIESUBS_STAGING_DIR=

# Where the C# worker stages OCR image sources before dispatch.
# Default: /work/ocr.
#BCOOKIESUBS_OCR_STAGING_DIR=

# Directory where TMDB poster/episode images are written.
# Default: ./mediaItemPhotos next to the app; compose sets it to the
# shared media-photos volume (/app/mediaItemPhotos).
#MEDIA_PHOTOS_DIR=

# Set to 1 to log the periodic library-scan memory snapshot (debug aid).
#BCOOKIESUBS_SCAN_MEMORY_DIAGNOSTICS=1

# Set to 1/true when the whisper host(s) have CUDA support; the settings UI
# only offers the "use CUDA" Whisper option while this is set.
#WHISPER_GPU_AVAILABLE=1

# ============================================================================
# 9. Scripts & framework keys
# ============================================================================

# update-ollama.sh: models list file. Default: ./ollama-models.txt.
#OLLAMA_MODELS_FILE=

# setup.sh / update-ollama.sh: set to 1 to disable their colored output.
#NO_COLOR=1

# Standard ASP.NET keys (set inside docker-compose files; rarely needed in .env):
#   ConnectionStrings__Default   — direct DB connection string (dev outside compose)
#   ASPNETCORE_ENVIRONMENT       — Development / Production
#   ASPNETCORE_URLS              — listen addresses (compose fixes http://+:8080)
#   Orchestration__Url           — C# worker gateway URL as seen from Web
#   Orchestration__ListenPort    — gateway port on the worker (fixed 5100 in compose)
#   Worker__SigningKey           — same key as WORKER_JWT_SIGNING_KEY above
#   Worker__BootstrapToken       — same token as WORKER_BOOTSTRAP_TOKEN above
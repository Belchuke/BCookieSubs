<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('libraryrequests.title') %> — BCookieSubs</title>
  <%- include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast === 'error' && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast">
        <span class="toast-msg"><%= msg %></span>
        <button type="button" class="toast-close" aria-label="Close" data-toast-close>✕</button>
      </div>
    <% } %>

    <div class="page-header">
      <h1><%= __('libraryrequests.title') %></h1>
    </div>

    <div class="lrx-filter-bar">
      <div class="field lrx-search-field">
        <input type="search" id="lr-search" placeholder="<%= __('libraryrequests.searchPlaceholder') %>">
      </div>
      <div class="field lrx-genre-field">
        <select id="lr-genre-filter">
          <option value=""><%= __('libraryrequests.allGenres') %></option>
        </select>
      </div>
    </div>

    <div class="tabs lrx-tabs">
      <button type="button" id="lr-tab-btn-movie" class="tab-btn active" onclick="lrSwitchTab('movie')">
        <%= __('libraryrequests.movies') %><span class="badge badge-neutral lrx-badge-sm lr-tab-count" data-tab="movie"></span>
      </button>
      <button type="button" id="lr-tab-btn-series" class="tab-btn" onclick="lrSwitchTab('series')">
        <%= __('libraryrequests.series') %><span class="badge badge-neutral lrx-badge-sm lr-tab-count" data-tab="series"></span>
      </button>
      <button type="button" id="lr-tab-btn-unmatched" class="tab-btn" onclick="lrSwitchTab('unmatched')">
        <%= __('libraryrequests.unmatched') %><span class="badge badge-neutral lrx-badge-sm lr-tab-count" data-tab="unmatched"></span>
      </button>
    </div>

    <%# ── Movies tab (rendered client-side from /data?type=movie) ──────── %>
    <div id="lr-tab-movie">
      <div class="lr-grid" data-lr-root="movie"></div>
    </div>

    <%# ── Series tab (rendered client-side from /data?type=series) ─────── %>
    <div id="lr-tab-series" style="display:none">
      <div class="lr-grid" data-lr-root="series"></div>
    </div>

    <%# ── Unmatched tab (rendered client-side from /data?type=unmatched) ─ %>
    <div id="lr-tab-unmatched" style="display:none">
      <div class="lr-grid" data-lr-root="unmatched"></div>
    </div>
  </main>
</div>

<%# ── Subtitle source selection dialog ──────────────────────────────────── %>
<div class="modal-overlay" id="subtitle-source-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal lrx-source-modal">
    <div class="modal-header">
      <h2 id="subtitle-source-title"><%= __('libraryrequests.selectSource') %></h2>
      <button class="btn btn-icon" onclick="closeModal('subtitle-source-modal')">✕</button>
    </div>
    <div class="modal-body" id="subtitle-source-body">
      <p class="text-dim lrx-source-hint"><%= __('libraryrequests.chooseSubtitleSource') %></p>
      <div id="subtitle-source-list" class="lrx-source-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('subtitle-source-modal')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<%# ── Translate-season dialog (per-episode track picker) ──────────────────── %>
<div class="modal-overlay" id="season-translate-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2><%= __('libraryrequests.translateSeason') %></h2>
      <button class="btn btn-icon" onclick="closeModal('season-translate-modal')">✕</button>
    </div>
    <div class="modal-body">
      <p class="text-dim lrx-source-hint"><%= __('libraryrequests.seasonPickTracks') %></p>
      <div id="season-translate-list" class="season-tr-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('season-translate-modal')"><%= __('common.cancel') %></button>
      <button type="button" class="btn btn-primary" id="season-translate-confirm"><%= __('libraryrequests.translate') %></button>
    </div>
  </div>
</div>

<%# ── Change-match modal (unmatched items) ──────────────────────────────── %>
<div class="modal-overlay" id="lr-match-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal modal-wide">
    <div class="modal-header">
      <h2><%= __('libraryrequests.changeMatch') %> — <span id="lr-match-name"></span></h2>
      <button class="btn btn-icon" onclick="closeModal('lr-match-modal')">✕</button>
    </div>
    <p class="text-dim lrx-source-hint"><%= __('libraryrequests.changeMatchItemHint') %></p>
    <div class="field">
      <input type="search" id="lr-match-search" placeholder="<%= __('libraryrequests.searchMatchPlaceholder') %>" autocomplete="off">
    </div>
    <div id="lr-match-results" class="lp-tmdb-results lpx-mt-25"></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('lr-match-modal')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<%# ── Extras picker (create subtitles for the movie or a named extra) ────── %>
<div class="modal-overlay" id="lr-extras-picker" onclick="closeModalOnOverlay(event)">
  <div class="modal lrx-source-modal">
    <div class="modal-header">
      <h2><%= __('libraryrequests.chooseTarget') %></h2>
      <button class="btn btn-icon" onclick="closeModal('lr-extras-picker')">✕</button>
    </div>
    <div class="modal-body">
      <p class="text-dim lrx-source-hint"><%= __('libraryrequests.createSubtitle') %></p>
      <div id="lr-extras-picker-list" class="lrx-source-list"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('lr-extras-picker')"><%= __('common.cancel') %></button>
    </div>
  </div>
</div>

<script>
  window.LR_I18N = <%- JSON.stringify(i18n) %>;
  window.LR_PERMS = <%- JSON.stringify(perms) %>;
  window.LR_LANG_BY_ID = <%- JSON.stringify(langById) %>;
  window.LR_SHOW_POSTERS = <%= showPosters ? 'true' : 'false' %>;
  window.LR_USER_TARGET_LANG_IDS = <%- JSON.stringify(userTargetLangIds || []) %>;
</script>

<script src="/app.js"></script>
<script src="/libraryRequests.js"></script>
</body>
</html>
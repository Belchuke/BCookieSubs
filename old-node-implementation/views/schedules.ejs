<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('schedules.title') %> — BCookieSubs</title>
  <%-  include('theme-vars.ejs') %>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/static/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="mobile-topbar">
    <button class="hamburger-btn" id="hamburgerBtn" type="button" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="mobile-topbar-title">BCookieSubs</span>
  </header>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="app-shell">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <% if (locals.toast === 'error' && locals.msg) { %>
      <div class="toast toast-<%= toast %>" id="page-toast"><%= msg %></div>
    <% } %>

    <div class="page-header">
      <h1><%= __('schedules.title') %></h1>
      <% if (can('canManageSchedules')) { %>
        <button class="btn btn-primary" onclick="openModal('add-schedule-modal')"><%= __('schedules.add') %></button>
      <% } %>
    </div>

    <div class="card">
      <% if (schedules.length === 0) { %>
        <p class="empty-state"><%= __('schedules.noSchedules') %></p>
      <% } else { %>
        <div class="sch-list">
          <% var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] %>
          <% schedules.forEach(function(s) { %>
            <div class="sch-item">
              <div class="sch-item-head">
                <strong><%= s.taskName %></strong>
                <div class="sch-item-actions">
                  <span class="badge <%= s.enabled ? 'badge-success' : 'badge-neutral' %>"><%= s.enabled ? __('common.on') : __('common.off') %></span>
                  <% if (can('canManageSchedules')) { %>
                  <button class="btn btn-sm btn-secondary sched-edit-btn"
                          data-sched="<%- JSON.stringify(s).replace(/"/g, '&quot;') %>"><%= __('schedules.edit') %></button>
                  <form method="POST" action="/schedules/delete/<%= s.id %>"
                        class="sched-delete-form sch-inline">
                    <button type="submit" class="btn btn-sm btn-danger"><%= __('schedules.delete') %></button>
                  </form>
                  <% } %>
                </div>
              </div>
              <div class="text-dim sch-item-meta">
                Every <%= s.repeatInterval %> <%= s.repeatUnit %><%= s.repeatInterval > 1 ? 's' : '' %>
                <% if (s.repeatUnit === 'week') { %> on <%= days[s.dayOfTheWeek] %><% } %>,
                starting <%= String(s.startTimeHour).padStart(2,'0') %>:<%= String(s.startTimeMinute).padStart(2,'0') %>
                for <%= s.durationMinutes %> min
                <% if (s.lastRunAt) { %> · last run <%= s.lastRunAt.split(' ')[0] %><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<% if (can('canManageSchedules')) { %>
<div class="modal-overlay" id="add-schedule-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2><%= __('schedules.addTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('add-schedule-modal')">✕</button>
    </div>
    <form method="POST" action="/schedules/add">
      <div class="field">
        <label><%= __('schedules.taskName') %></label>
        <input type="text" name="taskName" value="translation" required>
      </div>
      <div class="field field-checkbox">
        <input type="checkbox" name="enabled" value="1" id="as-enabled" checked>
        <label for="as-enabled"><%= __('schedules.enabledLabel') %></label>
      </div>
      <div class="field-row">
        <div class="field">
          <label><%= __('schedules.repeatEvery') %></label>
          <input type="number" name="repeatInterval" value="1" min="1" required>
        </div>
        <div class="field">
          <label><%= __('schedules.unit') %></label>
          <select name="repeatUnit">
            <option value="day"><%= __('schedules.unitDay') %></option>
            <option value="week" selected><%= __('schedules.unitWeek') %></option>
            <option value="month"><%= __('schedules.unitMonth') %></option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label><%= __('schedules.dayOfWeek') %></label>
          <select name="dayOfTheWeek">
            <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(function(d,i){ %>
              <option value="<%= i %>"><%= d %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label><%= __('schedules.hour') %></label>
          <input type="number" name="startTimeHour" value="8" min="0" max="23" required>
        </div>
        <div class="field">
          <label><%= __('schedules.minute') %></label>
          <input type="number" name="startTimeMinute" value="0" min="0" max="59" required>
        </div>
      </div>
      <div class="field">
        <label><%= __('schedules.duration') %></label>
        <input type="number" name="durationMinutes" value="60" min="1" required>
      </div>
      <div class="field">
        <label><%= __('schedules.firstStartDate') %></label>
        <input type="date" name="firstStartAt">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('add-schedule-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('schedules.createSchedule') %></button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="edit-schedule-modal" onclick="closeModalOnOverlay(event)">
  <div class="modal">
    <div class="modal-header">
      <h2><%= __('schedules.editTitle') %></h2>
      <button class="btn btn-icon" onclick="closeModal('edit-schedule-modal')">✕</button>
    </div>
    <form method="POST" id="edit-sched-form" action="">
      <div id="edit-sched-fields"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('edit-schedule-modal')"><%= __('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= __('common.save') %></button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script src="/app.js"></script>
<script>
  document.querySelectorAll('.sched-delete-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm('Delete this schedule?')) e.preventDefault();
    });
  });

  <% if (can('canManageSchedules')) { %>
  var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  document.querySelectorAll('.sched-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var s = JSON.parse(btn.dataset.sched);
      document.getElementById('edit-sched-form').action = '/schedules/update/' + s.id;
      document.getElementById('edit-sched-fields').innerHTML = buildSchedFields(s);
      openModal('edit-schedule-modal');
    });
  });

  var SCHED_LABELS = {
    taskName:      '<%= __("schedules.taskName") %>',
    enabledLabel:  '<%= __("schedules.enabledLabel") %>',
    every:         '<%= __("schedules.every") %>',
    unit:          '<%= __("schedules.unit") %>',
    unitDay:       '<%= __("schedules.unitDay") %>',
    unitWeek:      '<%= __("schedules.unitWeek") %>',
    unitMonth:     '<%= __("schedules.unitMonth") %>',
    dayOfWeek:     '<%= __("schedules.dayOfWeek") %>',
    hour:          '<%= __("schedules.hour") %>',
    minute:        '<%= __("schedules.minute") %>',
    duration:      '<%= __("schedules.duration") %>'
  };

  function buildSchedFields(s) {
    var html = '';
    html += '<div class="field"><label>' + SCHED_LABELS.taskName + '</label>';
    html += '<input type="text" name="taskName" value="' + esc(s.taskName) + '" required></div>';
    html += '<div class="field field-checkbox"><input type="checkbox" name="enabled" value="1" id="es-en" ' + (s.enabled ? 'checked' : '') + '>';
    html += '<label for="es-en">' + SCHED_LABELS.enabledLabel + '</label></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>' + SCHED_LABELS.every + '</label><input type="number" name="repeatInterval" value="' + s.repeatInterval + '" min="1" required></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.unit + '</label><select name="repeatUnit">';
    html += '<option value="day"' + (s.repeatUnit === 'day' ? ' selected' : '') + '>' + SCHED_LABELS.unitDay + '</option>';
    html += '<option value="week"' + (s.repeatUnit === 'week' ? ' selected' : '') + '>' + SCHED_LABELS.unitWeek + '</option>';
    html += '<option value="month"' + (s.repeatUnit === 'month' ? ' selected' : '') + '>' + SCHED_LABELS.unitMonth + '</option>';
    html += '</select></div></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>' + SCHED_LABELS.dayOfWeek + '</label><select name="dayOfTheWeek">';
    DAYS.forEach(function(d, i) { html += '<option value="' + i + '"' + (s.dayOfTheWeek === i ? ' selected' : '') + '>' + d + '</option>'; });
    html += '</select></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.hour + '</label><input type="number" name="startTimeHour" value="' + s.startTimeHour + '" min="0" max="23" required></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.minute + '</label><input type="number" name="startTimeMinute" value="' + s.startTimeMinute + '" min="0" max="59" required></div>';
    html += '</div>';
    html += '<div class="field"><label>' + SCHED_LABELS.duration + '</label><input type="number" name="durationMinutes" value="' + s.durationMinutes + '" min="1" required></div>';
    return html;
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  <% } %>
</script>
</body>
</html>

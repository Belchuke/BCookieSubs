<%
  var _cats = {}
  permissions.forEach(function(p) {
    if (!_cats[p.category]) _cats[p.category] = []
    _cats[p.category].push(p)
  })
%>
<div class="perm-cb-wrap">
  <% Object.keys(_cats).forEach(function(cat) { %>
    <div>
      <div class="perm-cat-label"><%= cat %></div>
      <div class="checkbox-group perm-cb-group">
        <% _cats[cat].forEach(function(p) { %>
          <label class="checkbox-label" title="<%= p.description %>">
            <input type="checkbox" name="permissionKeys" value="<%= p.key %>" <%= checkedKeys.indexOf(p.key) !== -1 ? 'checked' : '' %>>
            <%= p.label %>
          </label>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

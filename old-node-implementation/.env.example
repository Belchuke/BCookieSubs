PORT=

AES_KEY=
DBPATH=

TRANSLATION_ROOT_DIR=

# Default UI language for new users (each user can still change their own in the
# app). A locale code from src/i18n.ts SUPPORTED_LOCALES — e.g. en, da, th, de, es.
# Unknown codes fall back to 'en'. Set by setup.sh; read at first-run seeding.
APP_DEFAULT_LANGUAGE=

# Font forced onto every style and inline override of Thai ASS/SSA subtitle
# output (see src/services/subtitleFontPolicy.ts). Must be a font family
# installed on your media server. Defaults to 'Garuda'; read at first-run
# seeding, changeable afterwards from Settings > Subtitle Fonts.
THAI_ASS_FONT=

THEMOVIEDB_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Required only if the /internal/* endpoints are used.
# Set to a long random string (e.g. `openssl rand -hex 32`). Callers must
# send it via the `X-Internal-Token` header. Background workers in this
# project currently call services directly and do NOT need this set.
INTERNAL_API_TOKEN=

# Override the Ollama HTTP base URL when running the Ollama service in a
# separate container (e.g. via docker-compose). Defaults to http://localhost:11434.
OLLAMA_BASE_URL=

# Whisper model download/cache directory. In Docker this is mounted from a
# named volume so models survive container rebuilds. Defaults to a temp dir.
WHISPER_MODEL_ROOT_PATH=

# Which GPU path setup.sh detected: cpu | nvidia | amd | metal. Single source
# of truth read by update-ollama.sh (and used to pick the docker-compose files).
GPU_TYPE=

# Set to 1 by setup.sh when an NVIDIA GPU is detected (whisper.cpp has a CUDA
# backend). AMD uses Ollama ROCm for inference, but whisper.cpp has no ROCm
# backend, so this stays blank on AMD and Whisper runs CPU-only. Controls whether
# the "Use CUDA for Whisper" checkbox is shown.
WHISPER_GPU_AVAILABLE=

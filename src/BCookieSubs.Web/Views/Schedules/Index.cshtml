@using BCookieSubs.Shared.Database.Entities
@using BCookieSubs.Shared.Database.Enums
@using BCookieSubs.Shared.Security
@using BCookieSubs.Web.Services
@inject CurrentUserContext CurrentUser
@{
    ViewData["Title"] = "Schedules";
    ViewData["ActiveNav"] = "schedules";
    var toast = Context.Request.Query["toast"].FirstOrDefault();
    var msg = Context.Request.Query["msg"].FirstOrDefault();

    var schedules = (List<Schedule>)ViewBag.Schedules!;
    var canManage = CurrentUser.HasPermission(Permissions.CanManageSchedules);
    string[] Days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
}
@if (toast == "error" && !string.IsNullOrEmpty(msg))
{
    <div class="toast toast-error" id="page-toast">@msg</div>
}

<div class="page-header">
  <h1>Schedules</h1>
  @if (canManage)
  {
    <button class="btn btn-primary" onclick="openModal('add-schedule-modal')">+ Add</button>
  }
</div>

<div class="card">
  @if (schedules.Count == 0)
  {
    <p class="empty-state">No schedules configured. Add one to gate translation to specific time windows.</p>
  }
  else
  {
    <div class="sch-list">
      @foreach (var s in schedules)
      {
        var unit = s.RepeatUnit.ToString().ToLowerInvariant() + (s.RepeatInterval > 1 ? "s" : "");
        var meta = $"Every {s.RepeatInterval} {unit}";
        if (s.RepeatUnit == RepeatUnit.Week)
        {
            meta += $" on {Days[(int)s.DayOfTheWeek]}";
        }
        meta += $", starting {s.StartTime.Hours:00}:{s.StartTime.Minutes:00} for {s.DurationMinutes} min";
        if (s.LastRunAt != null)
        {
            meta += $" · last run {s.LastRunAt.Value:yyyy-MM-dd}";
        }
        <div class="sch-item">
          <div class="sch-item-head">
            <strong>@s.TaskName</strong>
            <div class="sch-item-actions">
              <span class="badge @(s.Enabled ? "badge-success" : "badge-neutral")">@(s.Enabled ? "On" : "Off")</span>
              @if (canManage)
              {
                <button class="btn btn-sm btn-secondary sched-edit-btn"
                        data-sched='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                            id = s.Id,
                            taskName = s.TaskName,
                            enabled = s.Enabled,
                            repeatInterval = s.RepeatInterval,
                            repeatUnit = s.RepeatUnit.ToString().ToLowerInvariant(),
                            dayOfTheWeek = (int)s.DayOfTheWeek,
                            startTimeHour = s.StartTime.Hours,
                            startTimeMinute = s.StartTime.Minutes,
                            durationMinutes = s.DurationMinutes,
                        }))'>Edit</button>
                <form method="POST" action="/schedules/delete/@s.Id"
                      class="sched-delete-form sch-inline">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              }
            </div>
          </div>
          <div class="text-dim sch-item-meta">@meta</div>
        </div>
      }
    </div>
  }
</div>

@if (canManage)
{
  <div class="modal-overlay" id="add-schedule-modal" onclick="closeModalOnOverlay(event)">
    <div class="modal">
      <div class="modal-header">
        <h2>Add Schedule</h2>
        <button class="btn btn-icon" onclick="closeModal('add-schedule-modal')">✕</button>
      </div>
      <form method="POST" action="/schedules/add">
        @Html.AntiForgeryToken()
        <div class="field">
          <label>Task Name</label>
          <input type="text" name="taskName" value="translation" required>
        </div>
        <div class="field field-checkbox">
          <input type="checkbox" name="enabled" value="1" id="as-enabled" checked>
          <label for="as-enabled">Enabled</label>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Repeat Every</label>
            <input type="number" name="repeatInterval" value="1" min="1" required>
          </div>
          <div class="field">
            <label>Unit</label>
            <select name="repeatUnit">
              <option value="day">Day</option>
              <option value="week" selected>Week</option>
              <option value="month">Month</option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Day of Week</label>
            <select name="dayOfTheWeek">
              @foreach (var (d, i) in Days.Select((d, i) => (d, i)))
              {
                <option value="@i">@d</option>
              }
            </select>
          </div>
          <div class="field">
            <label>Hour (0–23)</label>
            <input type="number" name="startTimeHour" value="8" min="0" max="23" required>
          </div>
          <div class="field">
            <label>Minute (0–59)</label>
            <input type="number" name="startTimeMinute" value="0" min="0" max="59" required>
          </div>
        </div>
        <div class="field">
          <label>Duration (minutes)</label>
          <input type="number" name="durationMinutes" value="60" min="1" required>
        </div>
        <div class="field">
          <label>First Start Date</label>
          <input type="date" name="firstStartAt">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('add-schedule-modal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Schedule</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal-overlay" id="edit-schedule-modal" onclick="closeModalOnOverlay(event)">
    <div class="modal">
      <div class="modal-header">
        <h2>Edit Schedule</h2>
        <button class="btn btn-icon" onclick="closeModal('edit-schedule-modal')">✕</button>
      </div>
      <form method="POST" id="edit-sched-form" action="">
        @Html.AntiForgeryToken()
        <div id="edit-sched-fields"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('edit-schedule-modal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
}

@section Scripts {
@if (canManage)
{
<script>
  var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  document.querySelectorAll('.sched-delete-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm('Delete this schedule?')) e.preventDefault();
    });
  });

  document.querySelectorAll('.sched-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var s = JSON.parse(btn.dataset.sched);
      document.getElementById('edit-sched-form').action = '/schedules/update/' + s.id;
      document.getElementById('edit-sched-fields').innerHTML = buildSchedFields(s);
      openModal('edit-schedule-modal');
    });
  });

  var SCHED_LABELS = {
    taskName:      'Task Name',
    enabledLabel:  'Enabled',
    every:         'Every',
    unit:          'Unit',
    unitDay:       'Day',
    unitWeek:      'Week',
    unitMonth:     'Month',
    dayOfWeek:     'Day of Week',
    hour:          'Hour (0–23)',
    minute:        'Minute (0–59)',
    duration:      'Duration (minutes)'
  };

  function buildSchedFields(s) {
    var html = '';
    html += '<div class="field"><label>' + SCHED_LABELS.taskName + '</label>';
    html += '<input type="text" name="taskName" value="' + esc(s.taskName) + '" required></div>';
    html += '<div class="field field-checkbox"><input type="checkbox" name="enabled" value="1" id="es-en" ' + (s.enabled ? 'checked' : '') + '>';
    html += '<label for="es-en">' + SCHED_LABELS.enabledLabel + '</label></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>' + SCHED_LABELS.every + '</label><input type="number" name="repeatInterval" value="' + s.repeatInterval + '" min="1" required></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.unit + '</label><select name="repeatUnit">';
    html += '<option value="day"' + (s.repeatUnit === 'day' ? ' selected' : '') + '>' + SCHED_LABELS.unitDay + '</option>';
    html += '<option value="week"' + (s.repeatUnit === 'week' ? ' selected' : '') + '>' + SCHED_LABELS.unitWeek + '</option>';
    html += '<option value="month"' + (s.repeatUnit === 'month' ? ' selected' : '') + '>' + SCHED_LABELS.unitMonth + '</option>';
    html += '</select></div></div>';
    html += '<div class="field-row">';
    html += '<div class="field"><label>' + SCHED_LABELS.dayOfWeek + '</label><select name="dayOfTheWeek">';
    DAYS.forEach(function(d, i) { html += '<option value="' + i + '"' + (s.dayOfTheWeek === i ? ' selected' : '') + '>' + d + '</option>'; });
    html += '</select></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.hour + '</label><input type="number" name="startTimeHour" value="' + s.startTimeHour + '" min="0" max="23" required></div>';
    html += '<div class="field"><label>' + SCHED_LABELS.minute + '</label><input type="number" name="startTimeMinute" value="' + s.startTimeMinute + '" min="0" max="59" required></div>';
    html += '</div>';
    html += '<div class="field"><label>' + SCHED_LABELS.duration + '</label><input type="number" name="durationMinutes" value="' + s.durationMinutes + '" min="1" required></div>';
    return html;
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>
}
}